+# 036 diagnostic-only aggregate boundary clocks. No algorithm/work changes.
+import time as _diagnostic_036_clock
+from functools import wraps as _diagnostic_036_wraps
+from .telemetry import current_trace as _diagnostic_036_trace
+
+def _diagnostic_036_data(trace):
+    return trace._data.setdefault('diagnostic_036', {
+        'schema': 'm6-036-boundary-phase-diagnostic-v1',
+        'timing_scope': 'same-product-clock inclusive boundary intervals; sums/counts per phase, nested phases must not be added',
+        'phase_totals': {}, 'pairs': []})
+
+def _diagnostic_036_start():
+    trace = _diagnostic_036_trace()
+    return None if trace is None else (trace, _diagnostic_036_clock.perf_counter_ns())
+
+def _diagnostic_036_finish(token, name):
+    if token is None:
+        return
+    trace, started = token
+    elapsed = _diagnostic_036_clock.perf_counter_ns() - started
+    data = _diagnostic_036_data(trace)
+    scopes = [data]
+    if '_active_pair' in data:
+        scopes.append(data['_active_pair'])
+    for scope in scopes:
+        row = scope['phase_totals'].setdefault(name, {'count': 0, 'ns': 0})
+        row['count'] += 1
+        row['ns'] += elapsed
+
+def _diagnostic_036_function(name, function):
+    @_diagnostic_036_wraps(function)
+    def measured(*args, **kwargs):
+        token = _diagnostic_036_start()
+        if token is None:
+            return function(*args, **kwargs)
+        try:
+            result = function(*args, **kwargs)
+        finally:
+            _diagnostic_036_finish(token, name)
+        if name == 'integer_frame_total':
+            data = _diagnostic_036_data(token[0])
+            pair = data.get('_active_pair')
+            if pair is not None:
+                origin, factor, prepared = result
+                pair['frame_origin_exact'] = [str(value) for value in origin]
+                pair['frame_factor_exponent'] = factor.bit_length() - 1
+                pair['prepared_triangles'] = [len(side) for side in prepared]
+        return result
+    return measured
+
+def _diagnostic_036_surface(function):
+    @_diagnostic_036_wraps(function)
+    def measured(left, right, *args, **kwargs):
+        trace = _diagnostic_036_trace()
+        if trace is None:
+            return function(left, right, *args, **kwargs)
+        data = _diagnostic_036_data(trace)
+        previous = data.get('_active_pair')
+        pair = {'index': len(data['pairs']), 'left_id': left.object_id, 'right_id': right.object_id,
+                'input_vertex_counts': [len(left.vertices), len(right.vertices)],
+                'input_face_counts': [len(left.faces), len(right.faces)], 'phase_totals': {}}
+        data['pairs'].append(pair)
+        data['_active_pair'] = pair
+        token = _diagnostic_036_start()
+        try:
+            return function(left, right, *args, **kwargs)
+        finally:
+            _diagnostic_036_finish(token, 'surface_total')
+            if previous is None:
+                data.pop('_active_pair', None)
+            else:
+                data['_active_pair'] = previous
+    return measured
+
+for _diagnostic_036_name, _diagnostic_036_function_name in (
+    ('admit_total', '_admit'), ('integer_frame_total', '_integer_frame'),
+    ('distance_roots_total', '_distance_roots'), ('nearest_total', '_nearest'),
+    ('traversal_tree', '_nearest_tree'), ('traversal_linear', '_nearest_linear'),
+    ('rounded_distance', '_rounded_distance'), ('witness_reconstruction', '_witness'),
+    ('point_publication', '_publish_points'), ('canonical_source_proof', '_witness_triangle_provenance')):
+    globals()[_diagnostic_036_function_name] = _diagnostic_036_function(
+        _diagnostic_036_name, globals()[_diagnostic_036_function_name])
+measure_surface_proximity = _diagnostic_036_surface(measure_surface_proximity)
