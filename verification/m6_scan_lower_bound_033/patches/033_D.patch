+        if a and b and abs(a).bit_length() + abs(b).bit_length() > _MAX_SCRATCH_BITS:
+            raise _ScanLowerUnavailable('integer_width')
+        return a * b
+
+    def _compare(self, a, b):
+        self._charge('compare')
