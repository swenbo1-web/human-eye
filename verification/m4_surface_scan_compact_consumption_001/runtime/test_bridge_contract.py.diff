+            with self.subTest(profile=profile),synthetic_owner('P',profile=profile) as (owner,config,payload,selected,records):
+                config['external_group']=profile
+                owner.__init__(config)
+                self.assertEqual(owner.tools,[actor.base.NATIVE,selected])
+                request={'jsonrpc':'2.0','id':profile,'method':'tools/call','params':{
+                    'name':'human_eye_scene_observe','arguments':{'query':{'mode':'surface_scan','threshold_m':.002}}}}
+                self.assertEqual(owner.handle(request)['result'],payload)
+                identity=json.loads((Path(config['output'])/'IDENTITY.json').read_bytes())
+                self.assertEqual(identity['external_group'],profile)
+                self.assertEqual(identity['runtime_identity']['source_sha256'],config['source_sha256'])
+                proof=json.loads((Path(config['output'])/'PRODUCT_RUNTIME_PROOF.json').read_bytes())
