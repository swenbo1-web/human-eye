+def compact_row(row, document):
+    """Read one declared compact fact row without guessing identity or units."""
+    columns = document.get('match_columns')
+    objects = document.get('objects')
+    required = {'object_a', 'object_b', 'object_a_ref', 'object_b_ref', 'distance_m', 'distance_mm'}
+    if (document.get('display_encoding') != 'surface-scan-task-table-v1'
+            or not isinstance(columns, list) or any(not isinstance(key, str) for key in columns)
+            or len(set(columns)) != len(columns) or not required.issubset(columns)
+            or not isinstance(objects, list) or not isinstance(row, list) or len(row) != len(columns)):
+        return None
+    values = dict(zip(columns, row))
+    labels = []
+    for name_key, ref_key in (('object_a', 'object_a_ref'), ('object_b', 'object_b_ref')):
+        reference = values[ref_key]
+        if type(reference) is not int or not 0 <= reference < len(objects):
+            return None
+        obj = objects[reference]
+        if not isinstance(obj, dict) or obj.get('name') != values[name_key]:
+            return None
+        labels.append(obj)
+    return {'objects': labels, 'distance_mm': values['distance_mm'], 'distance_m': values['distance_m']}
+
