        ],
        "type": "object"
      },
      "name": "render_views"
    },
    {
      "description": "Frame a model-chosen world target in a registered direction with a full square width in metres. All display-participating scene triangles remain in the depth test. Returns one frame with an optional PNG. A matching frame can be read by ref without a fresh raster.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
