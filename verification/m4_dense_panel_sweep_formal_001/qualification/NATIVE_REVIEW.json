  "actual_tool_catalogue": [
    {
      "description": "Run persistent ordinary Python. scene_data(selectors=None) returns source_ref, source and current objects with identity, visibility, vertices in world metres, and object-local triangles. np, Fraction, shapely, PIL and Image are available. cameras gives six target-to-eye directions. render_views(names,include_images=False,fresh=False) returns globally fitted frames. render_local(direction,target_world_m,view_span_m,include_image=False,fresh=False) returns one 512px orthographic frame using the chosen direction, finite world target and full square width in metres. View directions are SCENE=(4,-4,3), TOP=(0,0,1), LEFT=(-1,0,1), RIGHT=(1,0,1), FRONT=(0,-1,1), BACK=(0,1,1). buffers[frame_ref] gives color, depth, owners and triangle_ids. Frame object_names and source_face_offsets map the zero-based owners and global triangle IDs. Pixel row/column origin is top-left with centres at integer index +0.5; background owner and triangle are -1. read_images([frame_ref,...]) attaches original cached PNGs. blender(code,timeout=30) reads current Blender. Keep arrays local and print compact facts and frame references. Variables persist between calls.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "name": "execute_python"
    },
    {
      "description": "Run persistent read-only ordinary Python in the current Blender with bpy, mathutils and NumPy. Returns stdout, stderr and errors.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "name": "execute_blender_code"
    },
    {
      "description": "Fit any chosen registered directions to the whole current scene. Returns frame metadata, with original PNGs if include_images is true.",
