tuple(F(v) for v in point) for point in list(hull.exterior.coords)[:-1]]; corners=[coords[key] for key in hullkeys]; area=sum(Polygon([[float(point[dim]) for dim in keep] for point in face['points']]).area for face in group_faces); rectangular=len(corners)==4 and abs(area-hull.area)<1e-12 and all(dot(sub(corners[(idx+1)%4],corners[idx]),sub(corners[(idx+2)%4],corners[(idx+1)%4]))==0 for idx in range(4))\n  record={'id':obj['name']+':'+','.join(map(str,sorted(group))),'object':obj['name'],'object_index':oi,'local_source_triangle_indices':sorted(group),'gids':[face['gid'] for face in group_faces],'normal':normal,'corners':corners,'center':tuple(sum(point[dim] for point in corners)/len(corners) for dim in range(3))}\n  if rectangular: surfaces.append(record)\n  else: record['reason']='Connected coplanar component is nonrectangular (L-shaped); cannot split into supported rectangles.';unsupported.append(record)\nprint('supported',len(surfaces),'unsupported',[(item['id'],item['reason']) for item in unsupported]); print([(item['id'],list(map(float,item['normal']))) for item in surfaces])"},"result":null,"error":null,"status":"in_progress"}}
