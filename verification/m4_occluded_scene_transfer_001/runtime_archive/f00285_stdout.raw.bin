rlap=clip(overlap,depth_diff)\n    if signed_area(overlap)!=0:occluders.append({'object':geometry['objects'][face['oi']]['name'],'object_index':face['oi'],'local_source_triangle_index':face['li']})\n   result['positive_area_occlusion']=bool(occluders);result['occluding_source_faces']=occluders;result['complete_readable']=not occluders and visible>=16 and boundary_count>=4\n  else:result['complete_readable']=False\n  surface['views'].append(result)\nfor surface in surfaces:\n witnesses=[view for view in surface['views'] if view['complete_readable']];fronts=[view for view in surface['views'] if view['front_facing']];surface['state']='covered' if witnesses else 'unknown';surface['witnesses']=witnesses\n surface['reason']='Whole front-facing rectangle is in frame, with exactly zero positive-area occlusion and sufficient owned and contrasting-boundary pixels.' if witnesses else ('No front-facing candidate in the registered finite camera pool.' if not fronts else ('Positive-area occlusion in every front-facing candidate.' if all(view['positive_area_occlusion'] for view in fronts) else 'Unoccluded candidate(s) lack required visible pixels or contrasting boundary pixels.'))\nprint('covered',sum(surface['state']=='covered' for surface in surfaces));print('remaining',[(surface['id'],surface['reason']) for surface in surfaces if surface['state']=='unknown'])\nfor name,x,y in [('TOP',135,175),('LEFT',234,483)]:\n gid=int(buffers[name]['triangle_ids'][y,x]); component=all_components[int(gid_component[gid])] if gid>=0 else None; print('sample',name,x,y,'gid',gid,'component',component['id'] if component else None,'center',component['center'] if component else None,'witness',[(view['view'],view['image_ref']) for view in component.get('witnesses',[])] if component else None)\n"},"result":{"content":[{"type":"text","text":"{\"stdout\": \"covered 18\\nremaining [('RackBase:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('RackBase:2,3', 'Positive-area occlusion in every front-facing candidate.'), ('RackRoof:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('LeftUpright:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('LeftUpright:2,3', 'Positive-area occlusion in every front-facing candidate.'), ('LeftUpright:4,5', 'Positive-area occlusion in every front-facing candidate.'), ('LeftUpright:6,7', 'Positive-area occlusion in every front-facing candidate.'), ('LeftUpright:8,9', 'Positive-area occlusion in every front-facing candidate.'), ('RightUpright:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('RightUpright:2,3', 'Positive-area occlusion in every front-facing candidate.'), ('RightUpright:4,5', 'Positive-area occlusion in every front-facing candidate.'), ('RightUpright:6,7', 'Positive-area occlusion in every front-facing candidate.'), ('RightUpright:8,9', 'Positive-area occlusion in every front-facing candidate.'), ('RightUpright:10,11', 'Positive-area occlusion in every front-facing candidate.'), ('LowerRearUnit:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('LowerRearUnit:2,3', 'Positive-area occlusion in every front-facing candidate.'), ('LowerRearUnit:4,5', 'Positive-area occlusion in every front-facing candidate.'), ('LowerRearUnit:6,7', 'Positive-area occlusion in every front-facing candidate.'), ('LowerRearUnit:10,11', 'Positive-area occlusion in every front-facing candidate.'), ('UpperRearUnit:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('UpperRearUnit:2,3', 'Positive-area occlusion in every front-facing candidate.'), ('UpperRearUnit:4,5', 'Positive-area occlusion in every front-facing candidate.'), ('UpperRearUnit:6,7', 'Positive-area occlusion in every front-facing candidate.'), ('UpperRearUnit:8,9', 'Positive-area occlusion in every front-facing candidate.'), ('UpperRearUnit:10,11', 'Positive-area occlusion in every front-facing candidate.'), ('FrontRightUnit:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('FrontRightUnit:2,3', 'Positive-area occlusion in every front-facing candidate.'), ('FrontRightUnit:4,5', 'Positive-area occlusion in every front-facing candidate.'), ('FrontRightUnit:6,7', 'Positive-area occlusion in every front-facing candidate.'), ('FrontRightUnit:8,9', 'Positive-area occlusion in every front-facing candidate.'), ('FrontRightUnit:10,11', 'Positive-area occlusion in every front-facing candidate.'), ('LowerFrontRail:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('LowerFrontRail:8,9', 'Positive-area occlusion in every front-facing candidate.'), ('LowerFrontRail:10,11', 'Positive-area occlusion in every front-facing candidate.'), ('UpperFrontRail:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('UpperFrontRail:8,9', 'Positive-area occlusion in every front-facing candidate.'), ('UpperFrontRail:10,11', 'Positive-area occlusion in every front-facing candidate.'), ('TurnedUnit:0,1', 'No front-facing candidate in the registered finite camera pool.'), ('TurnedUnit:2,3', 'Positive-area occlusion in every front-facing candidate.'), ('TurnedUnit:4,5', 'Positive-area occlusion in every front-facing candidate.'), ('TurnedUnit:6,7', 'Positive-area occlusion in every front-facing candidate.'), ('TurnedUnit:8,9', 'Positive-area occlusion in every front-facing candidate.'), ('TurnedUnit:10,11', 'Positive-area occlusion in every front-facing candidate.')]\\nsample TOP 135 175 gid 15 component RackRoof:2,3 center (Fraction(0, 1), Fraction(0, 1), Fraction(13, 2)) witness [('TOP', 'image-02'), ('LEFT', 'image-03'), ('RIGHT', 'image-04'), ('FRONT', 'image-05'), ('BACK', 'image-06')]\\nsample LEFT 234 483 gid 10 component RackBase:10,11 center (Fraction(-7, 1), Fraction(0, 1), Fraction(-1, 4)) witness [('LEFT', 'image-03')]\\n\", \"stderr\": \"\", \"error\": null}"}],"structured_content":null},"error":null,"status":"completed"}}
