)}\nfor idx,reg in enumerate(regions):\n if reg['status']=='covered':\n  witness=pixel_rows[reg['complete_witness_pixel_index']]; image=images[witness['image_index']]\n  actual=counts[image['view_name']][idx]\n  assert actual==(witness['visible_surface_pixels'],witness['contrasting_boundary_pixels']),(idx,actual,witness)\nprint('All 18 witness pixel and merged-boundary counts independently match current raw buffers.')\nfor name,view,xx,yy in [('sample_A','TOP',135,175),('sample_B','LEFT',234,483)]:\n frame=buffers[view]; global_tri=int(frame['triangle_ids'][yy,xx]); idx=int(face_to_region[global_tri]); reg=regions[idx]\n center=np.array(reg['center_world_m']); uu=np.array(reg['half_edge_u_world_m']); vv=np.array(reg['half_edge_v_world_m'])\n print(name,json.dumps({'region_index':idx,'object':geometry['objects'][reg['object_index']]['name'],'triangles':reg['source_triangle_index_ranges'],'hit_triangle':global_tri-int(offsets[reg['object_index']]),'center':center.tolist(),'corners':[(center-uu-vv).tolist(),(center+uu-vv).tolist(),(center+uu+vv).tolist(),(center-uu+vv).tolist()],'front':reg['front_direction_world']}))\nfor idx in [11,35]:\n reg=regions[idx]; print('target',idx,json.dumps(reg))\n print('groups', [obs['unobserved_view_groups']['rows'][group] for group in reg['unobserved_view_group_indices']])\nfrom collections import Counter\nprint('unknown reasons',Counter(reg['unobserved_reason'] for reg in regions if reg['status']=='unknown'))\nfor obj_idx,obj in enumerate(geometry['objects']):\n print(obj_idx,obj['name'],[(idx,reg['source_triangle_index_ranges'][0],reg['status'],reg['unobserved_reason']) for idx,reg in enumerate(regions) if reg['object_index']==obj_idx])"}}}}}
