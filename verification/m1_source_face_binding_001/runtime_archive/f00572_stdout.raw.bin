ason': 'positive_area_occlusion', 'view_indices': [3, 5]}, {'reason': 'positive_area_occlusion', 'view_indices': [0, 3, 4]}, {'reason': 'back_facing', 'view_indices': [2, 5]}]\\ncamera format {'basis': 'right=normalize(cross(-target_to_eye,up_seed)); true_up=cross(right,-target_to_eye); view rows right,true_up,target_to_eye.', 'common_center_world_m': [1.25, -0.84375, 4.65625], 'directions': ['SCENE', 'TOP', 'LEFT', 'RIGHT', 'FRONT', 'BACK'], 'frustum_boundary': 'Inclusive NDC [-1,1] on all axes; positive camera depth.', 'geometry_conversion': 'Source Fraction to nearest binary64 once, retaining full world geometry.', 'margin': {'per_side_fraction_of_unpadded_symmetric_span': 0.05, 'square_fit': 'max absolute right/up projection about the one common center'}, 'pixel_center_convention': 'NDC maps to (size-1)/2 coordinates; raster samples integer pixel index +0.5.', 'raster_depth_ties': 'Strict nearer update; an equal-depth sample retains the earlier supplied surface.', 'schema': 'active-coverage-full-scene-cameras-v1', 'scope': 'Whole-scene geometric raster cameras; no ROI IDs, visibility matrix or oracle input.', 'uniform_object_color_rgb': [180, 190, 205], 'views': [{'all_geometry_inside_frustum': True, 'camera_eye_world_m': [14.278159288680023, -13.871909288680023, 14.427369466510017], 'direction_rational': [4, -4, 3], 'eye': [14.278159288680023, -13.871909288680023, 14.427369466510017], 'eye_to_scene_unit': [-0.6246950475544243, 0.6246950475544243, -0.4685212856658182], 'far': 53.55526500848045, 'far_m': 53.55526500848045, 'half_span_m': 10.427615313810369, 'm_per_pixel': 0.04081258439847502, 'max_camera_depth_m': 32.700034380859705, 'min_camera_depth_m': 10.31838213019885, 'name': 'SCENE', 'ndc_bounds': [[-0.9090909090909091, -0.7833509099180558, -0.61707970\\n\", \"stderr\": \"\", \"error\": null}"}],"structured_content":null},"error":null,"status":"completed"}}
