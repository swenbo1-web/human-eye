{"jsonrpc": "2.0", "id": "private-list", "result": {"tools": [{"name": "human_eye_spatial_relations", "description": "Read current solid relations and surface distances from a target to 1..3 explicit candidates in one capture. Returns each pair, penetrating candidates and nearest separated ties; unknowns and incomplete sets stay explicit. Surface distance is not penetration depth. A supported transverse crossing includes its captured triangles and an approximate boundary location when publishable. Read-only: no images or actions.", "inputSchema": {"type": "object", "properties": {"target": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}, "candidates": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}, "minItems": 1, "maxItems": 3}, "include_aabb": {"type": "boolean", "default": false}}, "required": ["target", "candidates"], "additionalProperties": false}}, {"name": "human_eye_surface_nearest", "description": "Find the nearest triangle surfaces, in metres, from one current Blender mesh to all other meshes in the scene. Complete results give global nearest ties; partial results give best-known candidates and unresolved coverage. Surface distance is unsigned, not penetration depth. Includes available closest points in world metres and independent witness/direction status for each best-known candidate. Read-only: no images or actions. Example: {\"target\":{\"name\":\"Bracket\"}}.", "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}, "inputSchema": {"type": "object", "properties": {"target": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}}, "required": ["target"], "additionalProperties": false}}]}}
