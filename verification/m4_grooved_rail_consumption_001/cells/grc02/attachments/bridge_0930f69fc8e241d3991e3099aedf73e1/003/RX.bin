"]},"allOf":[{"contains":{"const":"surface_proximity"}},{"anyOf":[{"contains":{"const":"closed_solid_relation"}},{"contains":{"const":"spatial_relation"}}]}]}}}]}},{"if":{"required":["geometry"]},"then":{"required":["mode","target","candidates"],"properties":{"mode":{"const":"task"}}}}],"additionalProperties":false},"include_image":{"type":"boolean","default":true,"description":"False returns text evidence without rendering. mesh_structure diagnose requires false and reads only the registered target raw mesh; patch may explicitly request images. Other observation modes retain default true."},"task_context":{"type":"object","additionalProperties":false,"required":["task_id","task_run_id"],"properties":{"task_id":{"type":"string","minLength":1,"maxLength":128},"task_run_id":{"type":"string","minLength":1,"maxLength":128}}},"scene_delta":{"type":"object","additionalProperties":false,"description":"Optional observation-only snapshot transport. Empty object asks for full resync; a complete base revision and SHA256 enables a delta when worthwhile.","properties":{"base_revision":{"type":"string","minLength":1,"maxLength":256},"base_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"dependentRequired":{"base_revision":["base_fingerprint"],"base_fingerprint":["base_revision"]}},"response_detail":{"type":"string","enum":["full","brief"],"default":"full","description":"Optional display projection. Brief preserves measurements, scopes, unknowns and native image bytes while omitting named camera/raster diagnostics. Full is a new current observation, not retrieval of a previous observation. Errors and insufficient savings keep full."}},"allOf":[{"if":{"required":["query"],"properties":{"query":{"required":["mode"],"properties":{"mode":{"const":"directory"}}}}},"then":{"required":["include_image"],"properties":{"include_image":{"const":false},"task_instruction":{"const":""}},"not":{"anyOf":[{"required":["focal_id"]},{"required":["reference_id"]},{"required":["goal"]},{"re