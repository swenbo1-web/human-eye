[
  {
    "description": "Current Blender facts. Directory query={mode:directory} with include_image=false returns tight evaluated world bounds, AABB centers and an independent directory binding. Task set example: {\"include_image\":false,\"query\":{\"mode\":\"task\",\"target\":{\"name\":\"A\"},\"candidates\":[{\"name\":\"B\"}],\"requested_facts\":[\"closed_solid_relation\",\"surface_proximity\"]}}. Opt in to spatial_relation and surface_proximity for support-certified separation with closed-classification fallback. Unknown/duplicate rows remain. Complete penetration/nearest-separated sets require all relevant evidence; otherwise only known subsets are reported. Legacy objects pair/aabb supported. Global surface_nearest instead uses one query.objects selector without focal_id, or focal_id with query={\"mode\":\"surface_nearest\"}; session_id and include_image=false required. Complete means global nearest; partial means best-known. scene_revision/fingerprint bind this capture/source/revision; runtime_source_sha256 identifies code. Scene edits expire observations. Goals are caller criteria. For all current scene mesh pairs use query={\"mode\":\"surface_scan\",\"threshold_m\":0.002}. This text-only scan includes hidden meshes, needs no selectors, includes threshold equality and reports coverage. Its unsigned triangle-surface distance describes surface proximity. Solid relations require separate facts.",
    "inputSchema": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "query": {
                "properties": {
                  "mode": {
                    "const": "directory"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "query"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "focal_id"
                  ]
                },
                {
                  "required": [
                    "reference_id"
                  ]
                },
                {
                  "required": [
                    "goal"
                  ]
                },
                {
                  "required": [
                    "scene_delta"
                  ]
                }
              ]
            },
            "properties": {
              "include_image": {
                "const": false
              },
              "task_instruction": {
                "const": ""
              }
            },
            "required": [
              "include_image"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "properties": {
                  "mode": {
                    "const": "surface_nearest"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "query"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "query": {
                    "not": {
                      "required": [
                        "objects"
                      ]
                    }
                  }
                },
                "required": [
                  "focal_id"
                ]
              },
              {
                "not": {
                  "required": [
                    "focal_id"
                  ]
                },
                "properties": {
                  "query": {
                    "required": [
                      "objects"
                    ]
                  }
                }
              }
            ],
            "properties": {
              "include_image": {
                "const": false
              }
            },
            "required": [
              "session_id",
              "include_image"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "properties": {
                  "mode": {
                    "const": "surface_scan"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "query"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "focal_id"
                  ]
                },
                {
                  "required": [
                    "reference_id"
                  ]
                },
                {
                  "required": [
                    "goal"
                  ]
                },
                {
                  "required": [
                    "scene_delta"
                  ]
                }
              ]
            },
            "properties": {
              "include_image": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "properties": {
                  "mode": {
                    "const": "task"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "query"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "focal_id"
                  ]
                },
                {
                  "required": [
                    "reference_id"
                  ]
                },
                {
                  "required": [
                    "goal"
                  ]
                },
                {
                  "required": [
                    "scene_delta"
                  ]
                }
              ]
            },
            "properties": {
              "include_image": {
                "const": false
              }
            },
            "required": [
              "include_image"
            ]
          }
        }
      ],
      "properties": {
        "focal_id": {
          "minLength": 1,
          "type": "string"
        },
        "goal": {
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "target_clearance_m"
              ]
            },
            {
              "required": [
                "target_focal_pivot_world_m"
              ]
            },
            {
              "required": [
                "max_contact_normal_angle_deg"
              ]
            },
            {
              "required": [
                "max_tangent_yaw_mismatch_deg"
              ]
            }
          ],
          "dependentRequired": {
            "clearance_tolerance_m": [
              "target_clearance_m"
            ],
            "position_tolerance_m": [
              "target_focal_pivot_world_m"
            ],
            "target_clearance_m": [
              "clearance_tolerance_m"
            ],
            "target_focal_pivot_world_m": [
              "position_tolerance_m"
            ]
          },
          "description": "Optional caller-supplied task criteria, evaluated separately from execution. Omitted object IDs bind to the selected observation/action pair. These criteria are not independently verified as the human user's intent.",
          "properties": {
            "clearance_tolerance_m": {
              "minimum": 0,
              "type": "number"
            },
            "focal_id": {
              "minLength": 1,
              "type": "string"
            },
            "max_contact_normal_angle_deg": {
              "maximum": 180,
              "minimum": 0,
              "type": "number"
            },
            "max_tangent_yaw_mismatch_deg": {
              "maximum": 180,
              "minimum": 0,
              "type": "number"
            },
            "position_tolerance_m": {
              "minimum": 0,
              "type": "number"
            },
            "reference_id": {
              "minLength": 1,
              "type": "string"
            },
            "target_clearance_m": {
              "minimum": 0,
              "type": "number"
            },
            "target_focal_pivot_world_m": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "yaw_symmetry_order": {
              "enum": [
                1,
                2,
                4
              ],
              "type": "integer"
            }
          },
          "type": "object"
        },
        "include_image": {
          "default": true,
          "description": "False returns text evidence without rendering. surface_scan defaults to false and accepts only false. mesh_structure diagnose requires false and reads only the registered target raw mesh; patch may explicitly request images. Other observation modes retain default true.",
          "type": "boolean"
        },
        "query": {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "directory"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "additionalProperties": false,
                "properties": {
                  "mode": {}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "surface_nearest"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "additionalProperties": false,
                "properties": {
                  "mode": {},
                  "objects": {
                    "maxItems": 1
                  }
                }
              }
            },
            {
              "else": {
                "properties": {
                  "threshold_m": {
                    "exclusiveMinimum": 0,
                    "maximum": 0.01
                  }
                }
              },
              "if": {
                "properties": {
                  "mode": {
                    "const": "surface_scan"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "additionalProperties": false,
                "properties": {
                  "mode": {},
                  "threshold_m": {}
                },
                "required": [
                  "threshold_m"
                ]
              }
            },
            {
              "if": {
                "anyOf": [
                  {
                    "properties": {
                      "mode": {
                        "const": "task"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "target"
                    ]
                  },
                  {
                    "required": [
                      "candidates"
                    ]
                  }
                ]
              },
              "then": {
                "oneOf": [
                  {
                    "properties": {
                      "candidates": false,
                      "target": false
                    },
                    "required": [
                      "objects"
                    ]
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "candidates": {},
                      "geometry": {},
                      "mode": {},
                      "requested_facts": {
                        "allOf": [
                          {
                            "contains": {
                              "const": "surface_proximity"
                            }
                          },
                          {
                            "anyOf": [
                              {
                                "contains": {
                                  "const": "closed_solid_relation"
                                }
                              },
                              {
                                "contains": {
                                  "const": "spatial_relation"
                                }
                              }
                            ]
                          }
                        ],
                        "items": {
                          "enum": [
                            "closed_solid_relation",
                            "spatial_relation",
                            "surface_proximity",
                            "aabb"
                          ]
                        }
                      },
                      "target": {}
                    },
                    "required": [
                      "target",
                      "candidates"
                    ]
                  }
                ],
                "properties": {
                  "mode": {
                    "const": "task"
                  }
                },
                "required": [
                  "mode",
                  "requested_facts"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "geometry"
                ]
              },
              "then": {
                "properties": {
                  "mode": {
                    "const": "task"
                  }
                },
                "required": [
                  "mode",
                  "target",
                  "candidates"
                ]
              }
            }
          ],
          "description": "Selectors use name OR id. Legacy exact_pairs/nearest/top1 use object_ids/max_exact_pairs. nearest needs complete exact nonpenetrating order; top1 may prune by strict outward bounds and reports ties. Unknown/budget-limited proofs do not certify nearest.",
          "properties": {
            "alignment_evidence": {
              "default": true,
              "description": "False omits optional face angles and requires include_image=false; strict distance, host rigid-frame and action checks remain.",
              "type": "boolean"
            },
            "candidates": {
              "description": "1..3 explicit candidates in request order; one capture with target. Requires surface_proximity with spatial_relation or closed_solid_relation. Optional aabb supplies bounds.",
              "items": {
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "id"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  }
                ],
                "properties": {
                  "id": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            },
            "geometry": {
              "additionalProperties": false,
              "description": "Opt-in geometry from the original relation bindings. Vertices use world metres; captured triangles are optional.",
              "properties": {
                "include_triangles": {
                  "default": false,
                  "type": "boolean"
                },
                "objects": {
                  "items": {
                    "additionalProperties": false,
                    "oneOf": [
                      {
                        "required": [
                          "id"
                        ]
                      },
                      {
                        "required": [
                          "name"
                        ]
                      }
                    ],
                    "properties": {
                      "id": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string"
                      },
                      "name": {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "maxItems": 4,
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "objects"
              ],
              "type": "object"
            },
            "indices": {
              "items": {
                "maximum": 4095,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "label_object_ids": {
              "description": "Current full IDs for image annotation, separate from measurement object_ids: up to six related labels plus A/B. Missing pair/image, occlusion or undersampling is explicit; display only.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 6,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "max_exact_pairs": {
              "maximum": 255,
              "minimum": 1,
              "type": "integer"
            },
            "mode": {
              "enum": [
                "directory",
                "task",
                "surface_nearest",
                "surface_scan",
                "overview",
                "exact_pairs",
                "nearest",
                "top1",
                "mesh_structure",
                "mesh_surface"
              ],
              "type": "string"
            },
            "native_visual": {
              "additionalProperties": false,
              "description": "Display policy only; never execution permission. Auto uses a negotiated read-only native host, otherwise the analytical projection. Projection skips negotiation; multiscale requires support. Labels and contact sections require projection.",
              "properties": {
                "mode": {
                  "enum": [
                    "auto",
                    "projection",
                    "multiscale"
                  ],
                  "type": "string"
                },
                "view": {
                  "enum": [
                    "SCENE",
                    "XY",
                    "XZ"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "near_m": {
              "maximum": 0.001,
              "minimum": 0,
              "type": "number"
            },
            "object_ids": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 255,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "objects": {
              "description": "Legacy task: aabb 1..4 selectors; pair facts two ordered A to B.",
              "items": {
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "id"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  }
                ],
                "properties": {
                  "id": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array"
            },
            "operation": {
              "description": "Registered target reads. mesh_structure: diagnose text or patch images. mesh_surface (local opt-in): diagnose/reference/restore_preview require include_image=false; reference_patch uses a returned opaque patch_ref and optional native images. References are locally trusted; previews do not execute; the original task budget applies.",
              "enum": [
                "diagnose",
                "patch",
                "reference",
                "restore_preview",
                "reference_patch"
              ],
              "type": "string"
            },
            "patch_ref": {
              "pattern": "^[a-f0-9]{32}$",
              "type": "string"
            },
            "reference_ref": {
              "pattern": "^[a-f0-9]{32}$",
              "type": "string"
            },
            "request_id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "requested_facts": {
              "description": "task: spatial_relation proves strict full-referenced-vertex support separation or uses closed-shell classification, with geometry_scope identifying the performed proof. closed_solid_relation is zero-tolerance separated/touching/penetrating (positive-volume overlap, including containment) for represented connected closed triangle shells; invalid/ambiguous is unknown. surface_proximity independently gives nonnegative triangle-surface distance, original world witness points and positive-distance A-to-B direction; zero-distance direction is inapplicable. Boundary/nonmanifold counts do not certify solids. Penetrating/contained distances are not separated gaps. pair_relation's escape of A is not surface distance, nearest direction or minimum depth.",
              "items": {
                "enum": [
                  "aabb",
                  "center_delta",
                  "axis_gap",
                  "surface_clearance",
                  "solid_relation",
                  "nearest_witness",
                  "pair_relation",
                  "surface_proximity",
                  "closed_solid_relation",
                  "spatial_relation"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "support_plane_discovery": {
              "additionalProperties": false,
              "description": "Read-only discovery of bounded original support-plane selectors for the current focal/reference pair. Omit direction for geometry only; no action direction is invented.",
              "properties": {
                "direction_world": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "max_candidates": {
                  "default": 4,
                  "maximum": 6,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "target": {
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "id"
                  ]
                },
                {
                  "required": [
                    "name"
                  ]
                }
              ],
              "properties": {
                "id": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "task_ref": {
              "description": "Trusted begin handoff, required in local lifecycle mode; selects the active generation without creating or renewing a task.",
              "pattern": "^[a-f0-9]{32}$",
              "type": "string"
            },
            "threshold_m": {
              "minimum": 0,
              "type": "number"
            },
            "visual_diagnostic": {
              "description": "Analytical full-mesh contact section beside natural views; not visibility evidence or action permission.",
              "enum": [
                "contact_section"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "reference_id": {
          "minLength": 1,
          "type": "string"
        },
        "response_detail": {
          "default": "full",
          "description": "Optional display projection. Brief preserves measurements, scopes, unknowns and native image bytes while omitting named camera/raster diagnostics. Full is a new current observation, not retrieval of a previous observation. Errors and insufficient savings keep full.",
          "enum": [
            "full",
            "brief"
          ],
          "type": "string"
        },
        "scene_delta": {
          "additionalProperties": false,
          "dependentRequired": {
            "base_fingerprint": [
              "base_revision"
            ],
            "base_revision": [
              "base_fingerprint"
            ]
          },
          "description": "Optional observation-only snapshot transport. Empty object asks for full resync; a complete base revision and SHA256 enables a delta when worthwhile.",
          "properties": {
            "base_fingerprint": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "base_revision": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "task_context": {
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "task_run_id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "task_id",
            "task_run_id"
          ],
          "type": "object"
        },
        "task_instruction": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "human_eye_scene_observe"
  }
]
