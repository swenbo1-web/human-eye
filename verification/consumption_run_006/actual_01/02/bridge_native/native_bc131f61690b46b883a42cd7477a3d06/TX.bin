{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\ndg=bpy.context.evaluated_depsgraph_get()\nrows=[]\nfor o in s.objects:\n    if o.type!='MESH': continue\n    e=o.evaluated_get(dg)\n    me=e.to_mesh()\n    try:\n        me.calc_loop_triangles()\n        rows.append({'name':o.name,'evaluated_world_triangles':[[list(e.matrix_world@me.vertices[i].co) for i in t.vertices] for t in me.loop_triangles]})\n    finally:\n        e.to_mesh_clear()\nprint(json.dumps({'scale_length':s.unit_settings.scale_length,'mesh_count':len(rows),'meshes':rows},allow_nan=False))"}}
