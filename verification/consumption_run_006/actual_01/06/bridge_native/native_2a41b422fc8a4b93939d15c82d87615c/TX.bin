{"type":"execute_code","params":{"code":"import bpy, json, math\nscene=bpy.context.scene\ndepsgraph=bpy.context.evaluated_depsgraph_get()\nresult={'unit_system':scene.unit_settings.system,'scale_length':scene.unit_settings.scale_length,'objects':[]}\nfor obj in scene.objects:\n    if obj.type!='MESH':\n        continue\n    ev=obj.evaluated_get(depsgraph)\n    me=ev.to_mesh()\n    try:\n        me.calc_loop_triangles()\n        mat=ev.matrix_world\n        coords=[list(mat @ v.co) for v in me.vertices]\n        tris=[list(t.vertices) for t in me.loop_triangles]\n        finite=all(math.isfinite(x) for p in coords for x in p)\n        result['objects'].append({'name':obj.name,'vertices':coords,'triangles':tris,'finite':finite,'modifiers':[m.type for m in obj.modifiers]})\n    finally:\n        ev.to_mesh_clear()\nprint(json.dumps(result,allow_nan=False))"}}
