{"type":"execute_code","params":{"code":"import bpy, json, math\n_t02_meshes={}\n_t02_summaries=[]\nfor o in bpy.context.scene.objects:\n    if o.type!='MESH': continue\n    m=o.matrix_world\n    vs=[tuple(sum(float(m[i][j])*float(v.co[j]) for j in range(3))+float(m[i][3]) for i in range(3)) for v in o.data.vertices]\n    fs=[tuple(p.vertices) for p in o.data.polygons]\n    _t02_meshes[o.name]={'vertices':vs,'faces':fs}\n    row={'name':o.name,'matrix_world':[list(r) for r in m],'vertices':len(vs),'faces':len(fs),'face_sizes':sorted(set(map(len,fs))),'bbox_min':[min(v[i] for v in vs) for i in range(3)],'bbox_max':[max(v[i] for v in vs) for i in range(3)],'nonfinite':sum(not all(math.isfinite(c) for c in v) for v in vs)}\n    if len(vs)<=3: row['world_vertices']=vs; row['faces_indices']=fs\n    _t02_summaries.append(row)\nprint(json.dumps(_t02_summaries,ensure_ascii=False))"}}
