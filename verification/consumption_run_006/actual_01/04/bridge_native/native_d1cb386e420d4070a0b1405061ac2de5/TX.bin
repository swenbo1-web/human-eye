{"type":"execute_code","params":{"code":"import bpy, json, math\ndg=bpy.context.evaluated_depsgraph_get()\nrows=[]\nfor o in bpy.context.scene.objects:\n    if o.type!='MESH': continue\n    e=o.evaluated_get(dg)\n    m=e.matrix_world\n    vs=[tuple(sum(float(m[i][j])*float(v.co[j]) for j in range(3))+float(m[i][3]) for i in range(3)) for v in e.data.vertices]\n    fs=[tuple(p.vertices) for p in e.data.polygons]\n    original=_t02_meshes[o.name]\n    rows.append({'name':o.name,'evaluated_matches_read':vs==original['vertices'] and fs==original['faces'],'shape_keys':o.data.shape_keys is not None,'faces':len(fs),'nonfinite':any(not all(math.isfinite(c) for c in v) for v in vs)})\nf=_t02_meshes['M4_Focal']; n=_t02_meshes['M4_Near']\nmatching_yz=[a[1:]==b[1:] for a,b in zip(f['vertices'],n['vertices'])]\nd=n['vertices'][0][0]-f['vertices'][0][0]\nfar_lbs={name:min(v[0] for v in mesh['vertices'])-max(v[0] for v in f['vertices']) for name,mesh in _t02_meshes.items() if name not in ['M4_Focal','M4_Near']}\nprint(json.dumps({'evaluated_checks':rows,'other_mesh_count':len(rows)-1,'focal_and_near_equal_yz':matching_yz,'focal_near_distance_m':d*bpy.context.scene.unit_settings.scale_length,'other_mesh_x_separation_lower_bounds_m':far_lbs,'unresolved':[]},ensure_ascii=False))"}}
