{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\nout={'scene':s.name,'unit_system':s.unit_settings.system,'scale_length':s.unit_settings.scale_length,'objects':[]}\nfor o in s.objects:\n    item={'name':o.name,'type':o.type}\n    if o.type=='MESH':\n        mesh=o.data\n        mesh.calc_loop_triangles()\n        item.update({'vertices_world':[list(o.matrix_world @ v.co) for v in mesh.vertices], 'triangles':[list(t.vertices) for t in mesh.loop_triangles], 'polygons':[list(p.vertices) for p in mesh.polygons], 'modifiers':[{'name':m.name,'type':m.type,'show_viewport':m.show_viewport} for m in o.modifiers], 'hidden':o.hide_get()})\n    out['objects'].append(item)\nprint(json.dumps(out,ensure_ascii=False))"}}
