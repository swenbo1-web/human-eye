{"type":"execute_code","params":{"code":"import bpy,json,math\nsc=bpy.context.scene\ndg=bpy.context.evaluated_depsgraph_get()\nout=[]\nfor ob in sc.objects:\n    if ob.type!='MESH': continue\n    eo=ob.evaluated_get(dg)\n    me=eo.to_mesh()\n    try:\n        vv=[[float(x) for x in eo.matrix_world@v.co] for v in me.vertices]\n        pp=[list(p.vertices) for p in me.polygons]\n        out.append({'name':ob.name,'evaluated_world_vertices':vv,'evaluated_faces':pp,'shape_keys':ob.data.shape_keys is not None,'constraints':len(ob.constraints),'all_coordinates_finite':all(math.isfinite(x) for v in vv for x in v)})\n    finally:\n        eo.to_mesh_clear()\nprint(json.dumps({'mesh_count':len(out),'evaluated_geometry':out},ensure_ascii=False))"}}
