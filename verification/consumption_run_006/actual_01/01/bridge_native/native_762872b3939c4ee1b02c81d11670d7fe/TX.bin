{"type":"execute_code","params":{"code":"import bpy,json,math\nsc=bpy.context.scene\ndata=[]\nfor o in sc.objects:\n    if o.type!='MESH': continue\n    me=o.data\n    verts=[list(o.matrix_world@v.co) for v in me.vertices]\n    faces=[list(p.vertices) for p in me.polygons]\n    data.append({'name':o.name,'matrix_world':[list(row) for row in o.matrix_world],'world_vertices':verts,'faces':faces,'finite':all(math.isfinite(x) for v in verts for x in v)})\nprint(json.dumps({'meshes':data,'instances':[{'name':i.object.name,'is_instance':i.is_instance} for i in bpy.context.evaluated_depsgraph_get().object_instances]},ensure_ascii=False))"}}
