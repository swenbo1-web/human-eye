{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\ninfo={'scene':s.name,'units':{'system':s.unit_settings.system,'scale_length':s.unit_settings.scale_length,'length_unit':s.unit_settings.length_unit},'meshes':[{'name':o.name,'type':o.type,'vertices':len(o.data.vertices),'polygons':len(o.data.polygons),'modifiers':[{'type':m.type,'name':m.name,'show_viewport':m.show_viewport} for m in o.modifiers], 'matrix_world':[list(row) for row in o.matrix_world]} for o in s.objects if o.type=='MESH'],'objects_count':len(s.objects)}\nprint(json.dumps(info,ensure_ascii=False))"}}
