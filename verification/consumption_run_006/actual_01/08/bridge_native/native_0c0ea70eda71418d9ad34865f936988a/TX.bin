{"type":"execute_code","params":{"code":"import bpy,json\ns=bpy.context.scene\nout=[]\nfor o in s.objects:\n    if o.type!='MESH': continue\n    o.data.calc_loop_triangles()\n    out.append({'name':o.name,'vertices_local':[list(v.co) for v in o.data.vertices],'vertices_world':[list(o.matrix_world@v.co) for v in o.data.vertices],'triangles':[list(t.vertices) for t in o.data.loop_triangles],'polygons':[list(p.vertices) for p in o.data.polygons]})\nprint(json.dumps({'scale_length':s.unit_settings.scale_length,'objects':out},ensure_ascii=False,allow_nan=True))"}}
