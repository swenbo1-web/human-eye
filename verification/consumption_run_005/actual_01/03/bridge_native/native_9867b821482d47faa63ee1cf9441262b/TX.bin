{"type":"execute_code","params":{"code":"import bpy, json\nsc=bpy.context.scene\nprint(json.dumps({'scene':sc.name,'unit_system':sc.unit_settings.system,'scale_length':sc.unit_settings.scale_length,'meshes':[{'name':o.name,'vertices':len(o.data.vertices),'polygons':len(o.data.polygons),'modifiers':[m.type for m in o.modifiers],'matrix_world':[list(row) for row in o.matrix_world],'hide_viewport':o.hide_viewport,'hide_render':o.hide_render} for o in sc.objects if o.type=='MESH']},ensure_ascii=False))"}}
