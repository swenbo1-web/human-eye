{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\nprint(json.dumps({'scene':s.name,'units':{'system':s.unit_settings.system,'scale_length':s.unit_settings.scale_length},'objects':[{'name':o.name,'type':o.type,'hide_viewport':o.hide_viewport,'hide_render':o.hide_render,'data':o.data.name if o.data else None,'vertices':len(o.data.vertices) if o.type=='MESH' else None,'polygons':len(o.data.polygons) if o.type=='MESH' else None,'modifiers':[{'name':m.name,'type':m.type,'show_viewport':m.show_viewport} for m in o.modifiers],'matrix_world':[list(row) for row in o.matrix_world]} for o in s.objects]},ensure_ascii=False))"}}
