{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\nrows=[]\nfor o in s.objects:\n    if o.type!='MESH':\n        continue\n    rows.append({'name':o.name,'vertices_local':[list(v.co) for v in o.data.vertices],'vertices_world':[list(o.matrix_world @ v.co) for v in o.data.vertices],'polygons':[list(p.vertices) for p in o.data.polygons],'edges':[list(e.vertices) for e in o.data.edges],'bound_box_world':[list(o.matrix_world @ __import__('mathutils').Vector(v)) for v in o.bound_box]})\nprint(json.dumps({'mesh_count':len(rows),'meshes':rows},ensure_ascii=False))"}}
