{"type":"execute_code","params":{"code":"import bpy, json\nrows=[]\nfor o in bpy.context.scene.objects:\n    if o.type=='MESH':\n        rows.append({'name':o.name,'world_vertices':[[float(c) for c in o.matrix_world @ v.co] for v in o.data.vertices],'faces':[list(p.vertices) for p in o.data.polygons],'edges':[list(e.vertices) for e in o.data.edges]})\nprint(json.dumps(rows,ensure_ascii=False))"}}
