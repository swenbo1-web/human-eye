{"type":"execute_code","params":{"code":"import bpy, json\nfrom mathutils import Vector\nscene=bpy.context.scene\nrows=[]\nfor o in scene.objects:\n    if o.type=='MESH':\n        rows.append({'name':o.name,'vertices':len(o.data.vertices),'polygons':len(o.data.polygons),'matrix_world':[list(r) for r in o.matrix_world],'modifiers':[{'name':m.name,'type':m.type,'show_viewport':m.show_viewport} for m in o.modifiers],'hide_viewport':o.hide_viewport,'hide_render':o.hide_render})\nprint(json.dumps({'scene':scene.name,'units':{'system':scene.unit_settings.system,'scale_length':scene.unit_settings.scale_length},'meshes':rows},ensure_ascii=False))"}}
