{"type":"execute_code","params":{"code":"import bpy, json\ns = bpy.context.scene\ndg = bpy.context.evaluated_depsgraph_get()\nobjects = []\nfor o in s.objects:\n    if o.type != 'MESH':\n        continue\n    eo = o.evaluated_get(dg)\n    mesh = eo.to_mesh()\n    try:\n        mesh.calc_loop_triangles()\n        w = eo.matrix_world\n        vs = [list(w @ v.co) for v in mesh.vertices]\n        ts = [list(t.vertices) for t in mesh.loop_triangles]\n        objects.append({'name':o.name, 'vertices_world':vs, 'triangles':ts, 'modifiers':[m.type for m in o.modifiers], 'visible':o.visible_get()})\n    finally:\n        eo.to_mesh_clear()\nprint(json.dumps({'scene':s.name,'unit_system':s.unit_settings.system,'scale_length':s.unit_settings.scale_length,'objects':objects},ensure_ascii=False))"}}
