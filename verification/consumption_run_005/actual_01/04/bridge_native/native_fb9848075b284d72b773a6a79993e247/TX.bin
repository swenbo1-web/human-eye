{"type":"execute_code","params":{"code":"import bpy,json,math\nscene=bpy.context.scene\ndg=bpy.context.evaluated_depsgraph_get()\nread={}\nfor obj in scene.objects:\n    if obj.type!='MESH': continue\n    eo=obj.evaluated_get(dg)\n    verts=[tuple(eo.matrix_world@v.co) for v in eo.data.vertices]\n    faces=[tuple(p.vertices) for p in eo.data.polygons]\n    read[obj.name]={'vertices':verts,'faces':faces}\nf=read['M4_Focal']; n=read['M4_Near']\nassert f['faces']==[(0,1,2)] and n['faces']==[(0,1,2)]\nassert f['vertices']==[(0.,0.,0.),(0.,1.,0.),(0.,0.,1.)]\ndistance=n['vertices'][0][0]\nassert all(q==(p[0]+distance,p[1],p[2]) for p,q in zip(f['vertices'],n['vertices']))\nassert all(math.isfinite(c) for d in read.values() for v in d['vertices'] for c in v)\nassert all(len(face)==3 for d in read.values() for face in d['faces'])\nbounds=[]\nfor name,data in read.items():\n    if name in ('M4_Focal','M4_Near'): continue\n    used=[data['vertices'][i] for face in data['faces'] for i in face]\n    lower=min(v[0] for v in used)\n    assert lower>distance\n    bounds.append({'name':name,'proven_distance_lower_bound_m':lower*scene.unit_settings.scale_length,'triangles_covered':len(data['faces'])})\nprint(json.dumps({'mesh_count':len(read),'triangles_covered':sum(len(d['faces']) for d in read.values()),'all_evaluated_geometry_matches_initial_read':read==T02_geometry,'nearest_names':['M4_Near'],'minimum_distance_m':distance*scene.unit_settings.scale_length,'witness_points':[[0.0,0.0,0.0],list(n['vertices'][0])],'excluded_meshes':bounds,'clearance_3mm':distance*scene.unit_settings.scale_length>=0.003,'unresolved':[]},ensure_ascii=False))"}}
