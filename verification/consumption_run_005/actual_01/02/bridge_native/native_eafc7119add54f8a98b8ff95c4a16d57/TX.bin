{"type":"execute_code","params":{"code":"import bpy, json\nscene=bpy.context.scene\ndeps=bpy.context.evaluated_depsgraph_get()\nresult={'unit_system':scene.unit_settings.system,'scale_length':scene.unit_settings.scale_length,'objects':[]}\nfor obj in scene.objects:\n    if obj.type!='MESH':\n        continue\n    ev=obj.evaluated_get(deps)\n    mesh=ev.to_mesh()\n    try:\n        mesh.calc_loop_triangles()\n        result['objects'].append({'name':obj.name,'vertices':[list(ev.matrix_world @ v.co) for v in mesh.vertices],'triangles':[list(t.vertices) for t in mesh.loop_triangles],'polygons':[list(p.vertices) for p in mesh.polygons]})\n    finally:\n        ev.to_mesh_clear()\nprint(json.dumps(result,ensure_ascii=False))"}}
