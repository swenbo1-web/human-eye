TION1',json.dumps({k:surfaces[17][k] for k in ['center','extent','views']},separators=(',',':')))\nprint('observed by best view',collections.Counter(row['evidence']['view'] for row in coverage if row['status']=='observed'))"},"result":{"content":[{"type":"text","text":"{\"stdout\": \"{\\\"source\\\":\\\"explicitly labelled CAPTURE_REPLAY\\\",\\\"pool\\\":{\\\"SCENE\\\":{\\\"direction_target_to_eye\\\":[4,-4,3],\\\"reference\\\":\\\"image-01\\\",\\\"resolution\\\":[512,512]},\\\"TOP\\\":{\\\"direction_target_to_eye\\\":[0,0,1],\\\"reference\\\":\\\"image-02\\\",\\\"resolution\\\":[512,512]},\\\"LEFT\\\":{\\\"direction_target_to_eye\\\":[-1,0,1],\\\"reference\\\":\\\"image-03\\\",\\\"resolution\\\":[512,512]},\\\"RIGHT\\\":{\\\"direction_target_to_eye\\\":[1,0,1],\\\"reference\\\":\\\"image-04\\\",\\\"resolution\\\":[512,512]},\\\"FRONT\\\":{\\\"direction_target_to_eye\\\":[0,-1,1],\\\"reference\\\":\\\"image-05\\\",\\\"resolution\\\":[512,512]},\\\"BACK\\\":{\\\"direction_target_to_eye\\\":[0,1,1],\\\"reference\\\":\\\"image-06\\\",\\\"resolution\\\":[512,512]}},\\\"surface_discovery\\\":{\\\"supported\\\":138,\\\"two_triangle_surfaces\\\":132,\\\"512_triangle_surfaces\\\":6,\\\"exact_fraction_coplanarity_rectangle_and_positive_area_shadow_tests\\\":true},\\\"observed_ids\\\":[0,1,2,3,5,6,7,8,9,11,12,13,14,15,17,18,19,20,21,23,24,25,26,27,29,30,31,32,33,35,36,37,38,39,40,42,43,44,45,46,48,49,50,51,52,53,55,56,57,58,59,60,62,63,64,65,66,68,69,70,71,72,74,75,76,77,78,80,81,82,83,84,86,87,88,89,90,92,94,95,96,97,99,100,101,102,103,105,106,107,108,109,111,112,113,114,115,116,118,119,120,121,122,124,125,126,127,128,130,131,132,133,134,136,137],\\\"remaining_ids\\\":[4,10,16,22,28,34,41,47,54,61,67,73,79,85,91,93,98,104,110,117,123,129,135],\\\"surface_rows\\\":[{\\\"id\\\":0,\\\"source_triangle_indices_inclusive\\\":[0,1],\\\"triangle_count\\\":2,\\\"status\\\":\\\"observed\\\",\\\"evidence\\\":{\\\"view\\\":\\\"LEFT\\\",\\\"reference\\\":\\\"image-03\\\",\\\"pixels\\\":3