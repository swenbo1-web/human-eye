{"type":"item.started","item":{"id":"item_8","type":"mcp_tool_call","server":"arm_engine","tool":"execute_python","arguments":{"code":"tri_surface=np.full(len(tris),-2,dtype=int)\nfor s in surfaces: tri_surface[s['triangles']]=s['id']\nview_refs=dict(zip([v['name'] for v in cameras['views']],['image-01','image-02','image-03','image-04','image-05','image-06']))\nmetrics={}\nfor view in cameras['views']:\n name=view['name']; buf=buffers[name]; tids=buf['triangle_ids']; identity=np.full(tids.shape,-1,dtype=int); mask=tids>=0;identity[mask]=tri_surface[tids[mask]]\n # unsupported gets distinct component identity (single here)\n rgb=buf['color'].astype(np.int32); marked=np.zeros(tids.shape,bool)\n for axis in [0,1]:\n  a=(slice(None,-1),slice(None)) if axis==0 else (slice(None),slice(None,-1));b=(slice(1,None),slice(None)) if axis==0 else (slice(None),slice(1,None))\n  contrast=(identity[a]!=identity[b])&(np.sum((rgb[a]-rgb[b])**2,axis=2)>=576)\n  marked[a]|=contrast;marked[b]|=contrast\n metrics[name]={s['id']:{'pixels':int(np.sum(identity==s['id'])),'boundary_pixels':int(np.sum(marked&(identity==s['id'])))} for s in surfaces}\n buf['surface_ids']=identity\nprint('pick tid',buffers['SCENE']['triangle_ids'][247,109],'surface',buffers['SCENE']['surface_ids'][247,109])\nfor s in surfaces:\n center=tuple(sum(p[i] for p in s['corners'])/4 for i in range(3));s['center']=center\n if s['id']==int(buffers['SCENE']['surface_ids'][247,109]) or center in [(0,0,0),(Fraction(5,32),Fraction(-5,32),Fraction(237,2048))]:\n  print('check',s,'metrics',{v:metrics[v][s['id']] for v in metrics})\nprint('normals',Counter(s['normal'] for s in surfaces))"},"result":null,"error":null,"status":"in_progress"}}
