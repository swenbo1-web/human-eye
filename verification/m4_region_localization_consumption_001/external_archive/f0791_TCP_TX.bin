.sum()),'boundary_pixels':int((mask&boundary).sum()),'sample_pixel_xy':locations[len(locations)//2][::-1].tolist() if len(locations) else None}\nprint('pixel SCENE 109,247 triangle',int(buffers['SCENE']['triangle_ids'][247,109]),'surface',int(identities['SCENE'][247,109]))\nfor surface in surfaces:\n    if surface['center_exact']==(0,0,0) or surface['center_exact']==tuple(map(Fraction,['0.15625','-0.15625','0.11572265625'])) or surface['id']==int(identities['SCENE'][247,109]):\n        print('CHECK',surface,'pixels',{name:metrics[name][surface['id']] for name in refs})\n"}}}}}
