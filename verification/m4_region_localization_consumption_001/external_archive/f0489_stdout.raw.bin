{"type":"item.started","item":{"id":"item_11","type":"mcp_tool_call","server":"arm_engine","tool":"execute_python","arguments":{"code":"def area(poly):\n    return sum((poly[i][0]*poly[(i+1)%len(poly)][1]-poly[i][1]*poly[(i+1)%len(poly)][0] for i in range(len(poly))),Fraction(0)) if len(poly)>=3 else Fraction(0)\ndef clip(poly,coeff):\n    if not poly: return []\n    out=[]; previous=poly[-1]; before=coeff[0]*previous[0]+coeff[1]*previous[1]+coeff[2]\n    for current in poly:\n        after=coeff[0]*current[0]+coeff[1]*current[1]+coeff[2]\n        if (before<0)!=(after<0):\n            ratio=before/(before-after); out.append(tuple(previous[k]+ratio*(current[k]-previous[k]) for k in (0,1)))\n        if after>=0: out.append(current)\n        previous=current; before=after\n    return out\nfor view in cameras['views']:\n    name=view['name']; direction=tuple(Fraction(x) for x in view['direction_rational']); seed=(1,0,0) if direction[0]==0 else (0,1,0)\n    u=cross(seed,direction); v=cross(direction,u); uu=dot(u,u); vv=dot(v,v); dd=dot(direction,direction)\n    projections=[(dot(p,u),dot(p,v)) for p in verts]\n    tri_projected=[[projections[i] for i in tri] for tri in tris]\n    bounds=np.array([[float(min(p[0] for p in poly)),float(min(p[1] for p in poly)),float(max(p[0] for p in poly)),float(max(p[1] for p in poly))] for poly in tri_projected])\n    depths=[]\n    for tid in range(len(tris)):\n        plane=planes[tid]\n        if plane is None or dot(plane[:3],direction)==0: depths.append(None); continue\n        normal=plane[:3]; denom=dot(normal,direction)/dd\n        depths.append((-dot(normal,u)/uu/denom,-dot(normal,v)/vv/denom,plane[3]/denom))\n    matrix=np.array(view['projection_matrix'])@np.array(view['view_matrix'])\n    for surface in surfaces:\n        record=surface['views'][name]; facing=dot(surface['normal'],direction)\n        record['facing']='front' if facing>0 else ('back' if facing<0 else 'edge')\n        corners_np=np.array([[float(x) for x in p]+[1.] for p in surface['corners']]); ndc=corners_np@matrix.T\n        record['inside_viewport']=bool(np.all(np.abs(ndc[:,:3])<=1+1e-12))\n        record['occluder_triangle']=None\n        if facing<=0:\n            record['complete']=False; record['readable']=False; continue\n        poly=[(dot(p,u),dot(p,v)) for p in surface['corners']]\n        if area(poly)<0: poly=poly[::-1]\n        target_depth=depths[surface['triangles'][0]]\n        bbox=[float(min(p[0] for p in poly)),float(min(p[1] for p in poly)),float(max(p[0] for p in poly)),float(max(p[1] for p in poly))]\n        candidates=np.flatnonzero((bounds[:,0]<bbox[2])&(bounds[:,2]>bbox[0])&(bounds[:,1]<bbox[3])&(bounds[:,3]>bbox[1]))\n        own=set(surface['triangles'])\n        for tid_np in candidates:\n            tid=int(tid_np)\n            if tid in own or depths[tid] is None: continue\n            delta=tuple(depths[tid][k]-target_depth[k] for k in range(3))\n            if all(x==0 for x in delta): continue\n            shadow=tri_projected[tid]\n            for a,b in zip(poly,poly[1:]+poly[:1]):\n                dx=b[0]-a[0]; dy=b[1]-a[1]; shadow=clip(shadow,(-dy,dx,dy*a[0]-dx*a[1]))\n                if not shadow: break\n            if not shadow or area(shadow)==0: continue\n            shadow=clip(shadow,delta)\n            if shadow and area(shadow)!=0 and any(delta[0]*p[0]+delta[1]*p[1]+delta[2]>0 for p in shadow):\n                record['occluder_triangle']=tid; break\n        record['complete']=record['inside_viewport'] and record['occluder_triangle'] is None\n        record['readable']=record['complete'] and record['pixels']>=16 and record['boundary_pixels']>=4\n    print(name,'complete',sum(s['views'][name]['complete'] for s in surfaces),'readable',sum(s['views'][name]['readable'] for s in surfaces))\nfor s in surfaces:\n    s['status']='observed' if any(r['readable'] for r in s['views'].values()) else 'remaining'\nprint('status',Counter(s['status'] for s in surfaces))\nprint('remaining',[(s['id'],[float(x) for x in s['center']],list(s['normal']),[(n,r['facing'],r['occluder_triangle'],r['complete'],r['pixels'],r['boundary_pixels']) for n,r in s['views'].items()]) for s in surfaces if s['status']=='remaining'])\nprint('origin',surfaces[137]['views'])"},"result":null,"error":null,"status":"in_progress"}}
