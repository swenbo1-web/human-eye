 curr=start\n        while curr not in cycle:\n            cycle.append(curr); nxt=next(p for p in adj[curr] if p!=prev); prev,curr=curr,nxt\n        valid=curr==start and len(cycle)==len(adj)\n    if valid:\n        corners=[p for i,p in enumerate(cycle) if any(cross(sub(p,cycle[i-1]),sub(cycle[(i+1)%len(cycle)],p)))]\n        valid=len(corners)==4\n        if valid:\n            sides=[sub(corners[(i+1)%4],corners[i]) for i in range(4)]\n            valid=all(dot(sides[i],sides[(i+1)%4])==0 for i in range(4))\n            area2=sum((dot(normals[t],planes[t][:3]) for t in tids),Fraction(0))\n            rect2=2*dot(cross(sides[0],sides[1]),planes[tids[0]][:3])\n            valid=valid and abs(area2)==abs(rect2)\n    if valid:\n        surfaces.append({'id':len(surfaces),'triangles':tids,'corners':corners,'normal':planes[tids[0]][:3], 'center':tuple(sum(p[k] for p in corners)/4 for k in range(3))})\n    else: unsupported.append(tids)\nprint('supported',len(surfaces),'unsupported components',len(unsupported),'unsupported triangles',sum(map(len,unsupported)),'degenerate',len(degenerate))\nprint('triangle distributions',Counter(len(s['triangles']) for s in surfaces)); print('unsupported',unsupported[:10])"},"result":{"content":[{"type":"text","text":"{\"stdout\": \"supported 138 unsupported components 1 unsupported triangles 1 degenerate 0\\ntriangle distributions Counter({2: 132, 512: 6})\\nunsupported [[48]]\\n\", \"stderr\": \"\", \"error\": null}"}],"structured_content":null},"error":null,"status":"completed"}}
