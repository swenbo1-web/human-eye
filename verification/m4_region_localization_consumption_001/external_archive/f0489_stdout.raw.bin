{"type":"item.started","item":{"id":"item_15","type":"mcp_tool_call","server":"arm_engine","tool":"execute_python","arguments":{"code":"compact=[]\nfor row in coverage:\n    source=row['source_triangle_indices']; source=source if isinstance(source,list) else ['inclusive',*source['inclusive_range']]\n    if row['status']=='observed':\n        e=row['evidence']; compact.append([row['surface'],source,'observed',e['view'],e['ref'],e['surface_pixels'],e['unique_contrasting_boundary_pixels'],e['pixel_xy']])\n    elif row['surface']==93: compact.append([93,source,'remaining: positive-area occlusion in all six views',{n:[e['ref'],e['occluder_triangle'],e['surface_pixels']] for n,e in row['evidence'].items()}])\n    else: compact.append([row['surface'],source,'remaining: back-facing in all six views'])\nprint('COMPLETE COVERAGE TABLE. Observed columns: surface_id, zero-based source triangle indices (inclusive ranges explicitly tagged), status, actual view, current-session image ref, actual surface pixels, unique contrasting target boundary endpoints, example [x,y]. Every observed row has exact front-facing/whole-viewport/no-positive-area-shadow verification. Remaining back-facing rows refer to SCENE image-01, TOP image-02, LEFT image-03, RIGHT image-04, FRONT image-05, BACK image-06. No partial-view aggregation.')\nprint(json.dumps(compact,separators=(',',':')))"},"result":null,"error":null,"status":"in_progress"}}
