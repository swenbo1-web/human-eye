          "effect": "four computed pairs plus same-image selected pixels",
          "request": {
            "code": "def closest_segment(point,start,end):\n delta=end-start; return start+np.clip(np.dot(point-start,delta)/np.dot(delta,delta),0,1)*delta\n\ndef point_triangle(point,tri):\n start,second,third=tri; basis=np.stack([second-start,third-start],axis=1); uv=np.linalg.lstsq(basis,point-start,rcond=None)[0]\n candidates=[closest_segment(point,tri[index],tri[(index+1)%3]) for index in range(3)]\n if min(uv)>=-1e-12 and sum(uv)<=1+1e-12: candidates.append(start+basis@uv)\n return min(candidates,key=lambda candidate:np.dot(point-candidate,point-candidate))\n\ndef segment_pair(first_start,first_end,second_start,second_end):\n first_delta=first_end-first_start; second_delta=second_end-second_start\n candidates=[(first_start,closest_segment(first_start,second_start,second_end)),(first_end,closest_segment(first_end,second_start,second_end)),(closest_segment(second_start,first_start,first_end),second_start),(closest_segment(second_end,first_start,first_end),second_end)]\n basis=np.stack([first_delta,-second_delta],axis=1); params=np.linalg.lstsq(basis,second_start-first_start,rcond=None)[0]\n if min(params)>=0 and max(params)<=1: candidates.append((first_start+params[0]*first_delta,second_start+params[1]*second_delta))\n return min(candidates,key=lambda pair:np.sum((pair[0]-pair[1])**2))\n\ndef mesh_distance(source_name,indices,target_name):\n source_obj=objs[source_name]; target_obj=objs[target_name]; source_vertices=np.array(source_obj['vertices']); target_vertices=np.array(target_obj['vertices']); best=None\n for source_index in indices:\n  source_tri=source_vertices[source_obj['triangles'][source_index]]\n  for target_index,target_ids in enumerate(target_obj['triangles']):\n   target_tri=target_vertices[target_ids]\n   pairs=[(point,point_triangle(point,target_tri)) for point in source_tri]+[(point_triangle(point,source_tri),point) for point in target_tri]\n   pairs += [segment_pair(source_tri[first],source_tri[(first+1)%3],target_tri[second],target_tri[(second+1)%3]) for first in range(3) for second in range(3)]\n   for source_point,target_point in pairs:\n    distance=float(np.linalg.norm(source_point-target_point))\n    if best is None or distance<best[0]-1e-12: best=(distance,source_point,target_point,source_index,target_index)\n return best\nfor label,indices in [('selection',range(4)),('whole',range(6))]:\n for target in ['Obj_05','Obj_08']: print(label,target,mesh_distance('Obj_07',indices,target))\nprint('buffer keys',buffers[local['ref']].keys())\nfor name in ['Obj_07','Obj_05']:\n owner=local['object_names'].index(name); buf=buffers[local['ref']]; mask=buf['owners']==owner; print(name,'visible',int(mask.sum()),'tri counts',np.unique(buf['triangle_ids'][mask],return_counts=True))"
