{"type":"item.started","item":{"id":"item_7","type":"mcp_tool_call","server":"arm_engine","tool":"execute_python","arguments":{"code":"print([(o['name'],np.min(o['vertices'],0).tolist(),np.max(o['vertices'],0).tolist()) for o in data['objects']]); print('extra',v[289:].tolist(),t[512:].tolist())\n# Shared-edge connected components within each oriented plane.\ncomponents=[]\nfor plane, ids in planes.items():\n    edges=defaultdict(list)\n    for idx in ids:\n        for aa,bb in [(0,1),(1,2),(2,0)]:\n            edge=tuple(sorted((tuple(xyz[idx,aa]),tuple(xyz[idx,bb])))); edges[edge].append(idx)\n    adj=defaultdict(set)\n    for linked in edges.values():\n        for idx in linked: adj[idx].update(linked)\n    remaining=set(ids)\n    while remaining:\n        seed=remaining.pop(); component={seed}; stack=[seed]\n        while stack:\n            for neighbor in adj[stack.pop()] & remaining:\n                remaining.remove(neighbor); component.add(neighbor); stack.append(neighbor)\n        components.append((plane,sorted(component)))\nprint('components',[(p,len(ids)) for p,ids in components])"},"result":null,"error":null,"status":"in_progress"}}
