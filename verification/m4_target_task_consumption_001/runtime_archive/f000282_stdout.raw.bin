ool\": true,\n      \"complete_readable\": true,\n      \"complete_witness\": {\n        \"frame_ref\": \"native-image-001\",\n        \"view_name\": \"TOP\",\n        \"surface_pixels\": 216225,\n        \"boundary_pixels\": 1856\n      },\n      \"unknown_reason\": null,\n      \"source_references\": [\n        \"live-source-001：M4_Far_00 当前局部源三角形512、513，分别使用顶点[289,290,291]和[289,291,292]。\",\n        \"execute_python：共享边连通分量及源顶点绕序计算，得到本区域共2个三角形，面积1平方米。\",\n        \"execute_python：六个当前设备的连续投影、裁剪及遮挡检查均判定本区域正向、完整且无遮挡。\",\n        \"render_views(names=['TOP'], include_images=true)：当前实际图像native-image-001，source_ref=live-source-001，尺寸512×512。\",\n        \"execute_python：读取buffers['native-image-001']的color、owners、triangle_ids；本区域owner=13，全局三角形编号6146–6147；统计得到216225个表面像素、1856个满足RGB对比阈值的边界像素。\"\n      ],\n      \"notes\": \"SCENE、TOP、LEFT、RIGHT、FRONT、BACK均存在几何完整的正向无遮挡观察。实际完整可读见证采用TOP：全部区域位于裁剪范围内，连续几何检查不存在前方遮挡。图中表面RGB为[164,173,187]，外侧RGB为[18,22,30]；1856个不同的区域边界像素各自至少具有一个四邻域外侧像素，其RGB欧氏距离达到24。表面像素数≥16且合格边界像素数≥4，满足同一张图像的可读性要求。\"\n    }\n  ],\n  \"source_references\": [\n    \"scene_data()通过execute_python读取的当前源：live-source-001；kind=actual_owned_Blender_evaluated_mesh；instance_id=1e9912a790084207b5d6135c4963a165；frame=1；subframe=0；scale_length=1。\",\n    \"源asset_sha256=2d7c48f01665588bd7cfc93280ea50b559f4dc08196738c504ea56c88c75a164。\",\n    \"目标object_id=blender:ead1bf8d23b37a769b413b7b6c1a61ae96f90a30a64cf56ec160aaa76dedf15d；当前293个顶点、514个源三角形。\",\n    \"当前原生cameras.views有限池：SCENE、TOP、LEFT、RIGHT、FRONT、BACK。\",\n    \"native-image-001：view_name=TOP；PNG_sha256=257746c95fb7059523f6ced852a0f5138b63e67ba12ecfbcca0f6401a40b1a2e；NPZ_sha256=1939778223d3565131cb5114e8a0042e8f1e5ae5b07b94cf6991063993e72512。\"\n  ],\n  \"limitations\": [\n    \"仅检查当前场景及上述六个实际观察设备，不外推到其他视角。\",\n    \"最大连通平面区域依据源三角形共面性和共享几何边识别；共得到两个区域，完整覆盖局部源三角形0–513。\",\n    \"本次仅实际构造TOP图像。SCENE、LEFT、RIGHT、FRONT、BACK的图像像素可读性未运行、待证实；这些视图的连续几何完整性已单独计算。\",\n    \"没有把像素采样未呈现遮挡当作几何无遮挡证明。\",\n    \"全程只读，未移动、编辑场景或保存文件；几何形状、朝向及