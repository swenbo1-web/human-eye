{"jsonrpc": "2.0", "id": 2, "result": {"tools": [{"name": "human_eye_spatial_relations", "description": "Read current solid relations and surface distances from a target to 1..3 explicit candidates in one capture. Returns each pair, penetrating candidates and nearest separated ties; unknowns and incomplete sets stay explicit. Surface distance is not penetration depth. Read-only: no images or actions.", "inputSchema": {"type": "object", "properties": {"target": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}, "candidates": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}, "minItems": 1, "maxItems": 3}, "include_aabb": {"type": "boolean", "default": false}}, "required": ["target", "candidates"], "additionalProperties": false}}]}}
