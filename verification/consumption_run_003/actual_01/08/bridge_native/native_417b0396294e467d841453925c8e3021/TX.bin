{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\nout=[]\nfor o in s.objects:\n if o.type=='MESH':\n  out.append({'name':o.name,'matrix_world':[[float(v) for v in row] for row in o.matrix_world], 'vertices_local':[[float(v) for v in p.co] for p in o.data.vertices], 'polygons':[list(p.vertices) for p in o.data.polygons], 'vertices_world':[[float(v) for v in (o.matrix_world @ p.co)] for p in o.data.vertices], 'hide_viewport':o.hide_viewport, 'hide_render':o.hide_render})\nprint(json.dumps({'scale_length':s.unit_settings.scale_length,'meshes':out},ensure_ascii=False))"}}
