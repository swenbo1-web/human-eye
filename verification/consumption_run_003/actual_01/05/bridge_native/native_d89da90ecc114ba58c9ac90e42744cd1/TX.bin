{"type":"execute_code","params":{"code":"import bpy, json\nsc=bpy.context.scene\nprint(json.dumps({'scale_length':sc.unit_settings.scale_length,'meshes':[{'name':o.name,'world_vertices':[list(o.matrix_world @ v.co) for v in o.data.vertices], 'faces':[list(p.vertices) for p in o.data.polygons], 'matrix_world':[list(r) for r in o.matrix_world], 'hide_viewport':o.hide_viewport, 'hide_render':o.hide_render} for o in sc.objects if o.type=='MESH']},ensure_ascii=False))"}}
