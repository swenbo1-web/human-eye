{"type":"execute_code","params":{"code":"import bpy, json\nsc=bpy.context.scene\nprint(json.dumps({'scene':sc.name,'unit_system':sc.unit_settings.system,'scale_length':sc.unit_settings.scale_length,'objects':[{'name':o.name,'type':o.type,'vertices':len(o.data.vertices) if o.type=='MESH' else None,'polygons':len(o.data.polygons) if o.type=='MESH' else None,'modifiers':[{'name':m.name,'type':m.type,'show_viewport':m.show_viewport} for m in o.modifiers] if o.type=='MESH' else None} for o in sc.objects]}, ensure_ascii=False))"}}
