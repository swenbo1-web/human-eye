{"type":"execute_code","params":{"code":"import bpy,json,math\ns=bpy.context.scene\ndef world_xyz(o,v):\n    m=o.matrix_world\n    return tuple(sum(float(m[i][j])*float(v.co[j]) for j in range(3))+float(m[i][3]) for i in range(3))\nT02_geoms={}\nT02_summary=[]\nfor o in s.objects:\n    if o.type!='MESH': continue\n    vs=[world_xyz(o,v) for v in o.data.vertices]\n    fs=[tuple(p.vertices) for p in o.data.polygons]\n    T02_geoms[o.name]=(vs,fs)\n    deg=[]\n    nontri=[]\n    for k,f in enumerate(fs):\n        if len(f)!=3:\n            nontri.append(k);continue\n        a,b,c=[vs[i] for i in f]\n        u=[b[i]-a[i] for i in range(3)];v=[c[i]-a[i] for i in range(3)]\n        cr=[u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0]]\n        if not any(cr):deg.append(k)\n    T02_summary.append({'name':o.name,'bounds':[[min(p[i] for p in vs),max(p[i] for p in vs)] for i in range(3)],'vertices':len(vs),'triangles':len(fs),'nontriangles':nontri,'degenerate_faces':deg,'matrix_world':[list(row) for row in o.matrix_world],'small_mesh_geometry':{'vertices':vs,'faces':fs} if len(fs)<4 else None})\nprint(json.dumps(T02_summary,ensure_ascii=False))"}}
