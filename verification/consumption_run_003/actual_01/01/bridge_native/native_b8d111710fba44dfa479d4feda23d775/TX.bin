{"type":"execute_code","params":{"code":"import bpy, json\nprint(json.dumps({'meshes':[{'name':o.name,'world_vertices':[list(o.matrix_world@v.co) for v in o.data.vertices],'faces':[list(p.vertices) for p in o.data.polygons]} for o in bpy.context.scene.objects if o.type=='MESH']},ensure_ascii=False))"}}
