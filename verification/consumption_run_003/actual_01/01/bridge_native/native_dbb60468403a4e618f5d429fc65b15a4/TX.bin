{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\ndg=bpy.context.evaluated_depsgraph_get()\nchecks=[]\nfor o in s.objects:\n    if o.type != 'MESH':\n        continue\n    e=o.evaluated_get(dg)\n    verts=[tuple(float(x) for x in e.matrix_world@v.co) for v in e.data.vertices]\n    checks.append({'name':o.name,'evaluated_world_vertices':verts,'evaluated_faces':[list(p.vertices) for p in e.data.polygons],'shape_keys':o.data.shape_keys.name if o.data.shape_keys else None})\nprint(json.dumps({'mesh_count':sum(o.type=='MESH' for o in s.objects),'scale_length':s.unit_settings.scale_length,'checks':checks},ensure_ascii=False))"}}
