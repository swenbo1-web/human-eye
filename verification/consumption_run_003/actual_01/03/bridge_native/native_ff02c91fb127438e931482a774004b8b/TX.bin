{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\nout={'unit_system':s.unit_settings.system,'scale_length':s.unit_settings.scale_length,'objects':[]}\nfor o in s.objects:\n if o.type=='MESH':\n  me=o.data\n  out['objects'].append({'name':o.name,'vertices':[list(o.matrix_world @ v.co) for v in me.vertices],'polygons':[list(p.vertices) for p in me.polygons],'matrix_world':[list(r) for r in o.matrix_world],'modifiers':[{'name':m.name,'type':m.type,'show_viewport':m.show_viewport} for m in o.modifiers],'hidden':o.hide_get()})\nprint(json.dumps(out,ensure_ascii=False))"}}
