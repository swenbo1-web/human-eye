{"type":"execute_code","params":{"code":"import bpy, json\ns = bpy.context.scene\nout = {'scene':s.name,'units':{'system':s.unit_settings.system,'scale_length':s.unit_settings.scale_length},'objects':[]}\nfor o in s.objects:\n    row={'name':o.name,'type':o.type,'matrix_world':[list(r) for r in o.matrix_world],'hide_viewport':o.hide_viewport,'hide_render':o.hide_render}\n    if o.type=='MESH':\n        m=o.data\n        m.calc_loop_triangles()\n        row.update({'vertices':[list(o.matrix_world @ v.co) for v in m.vertices],'triangles':[list(t.vertices) for t in m.loop_triangles],'polygons':[list(p.vertices) for p in m.polygons],'modifiers':[{'name':q.name,'type':q.type,'show_viewport':q.show_viewport} for q in o.modifiers]})\n    out['objects'].append(row)\nprint(json.dumps(out,ensure_ascii=False))"}}
