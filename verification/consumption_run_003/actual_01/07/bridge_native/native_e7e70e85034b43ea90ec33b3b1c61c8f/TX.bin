{"type":"execute_code","params":{"code":"import bpy,json\nprint(json.dumps({'scale_length':bpy.context.scene.unit_settings.scale_length,'meshes':[{'name':o.name,'matrix_world':[list(row) for row in o.matrix_world],'vertices_world':[list(o.matrix_world @ v.co) for v in o.data.vertices],'faces':[list(p.vertices) for p in o.data.polygons],'hide_viewport':o.hide_viewport,'hide_render':o.hide_render} for o in bpy.context.scene.objects if o.type=='MESH']},ensure_ascii=False))"}}
