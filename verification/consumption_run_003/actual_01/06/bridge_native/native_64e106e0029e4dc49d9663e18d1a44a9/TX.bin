{"type":"execute_code","params":{"code":"import bpy, json\nscene = bpy.context.scene\ndg = bpy.context.evaluated_depsgraph_get()\nresult = {'scene': scene.name, 'unit_system': scene.unit_settings.system, 'scale_length': scene.unit_settings.scale_length, 'objects': []}\nfor obj in scene.objects:\n    item = {'name': obj.name, 'type': obj.type, 'hide_viewport': obj.hide_viewport, 'hide_render': obj.hide_render}\n    if obj.type == 'MESH':\n        ev = obj.evaluated_get(dg)\n        me = ev.to_mesh()\n        try:\n            me.calc_loop_triangles()\n            item.update({'vertices_count': len(me.vertices), 'polygons_count': len(me.polygons), 'triangle_count': len(me.loop_triangles), 'matrix_world': [list(row) for row in ev.matrix_world], 'modifiers': [{'type': m.type, 'show_viewport': m.show_viewport} for m in obj.modifiers]})\n            if len(me.vertices) <= 1000 and len(me.loop_triangles) <= 1000:\n                item['vertices_world'] = [list(ev.matrix_world @ v.co) for v in me.vertices]\n                item['triangles'] = [list(t.vertices) for t in me.loop_triangles]\n        finally:\n            ev.to_mesh_clear()\n    result['objects'].append(item)\nprint(json.dumps(result, allow_nan=False))"}}
