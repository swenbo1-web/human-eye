+"""Isolated two-box adapter; original closed selection, exact solver and projection."""
+from __future__ import annotations
+import copy
+import json
+import time
+
+from .source_region import (validate_scoped_measurement_arguments, measure_selective_region,
+    project_scoped_measurement, _validate_selective_capture, _selective_mesh_arrays,
+    _host_digest, _source_region_world_box)
+
+MODE = 'source_region_measurement_batch'
+
+
+def validate_batch_arguments(arguments):
+    query = arguments.get('query')
+    if (type(query) is not dict or set(query) != {'mode', 'region', 'reference', 'requested_facts'}
+            or query.get('mode') != MODE or type(query.get('region')) is not dict
+            or set(query['region']) != {'object', 'world_boxes_m'}
+            or type(query['region']['world_boxes_m']) is not list or len(query['region']['world_boxes_m']) != 2):
+        raise ValueError('source_region_batch_requires_two_ordered_boxes')
+    selected = []
+    for box in query['region']['world_boxes_m']:
+        single = {**query, 'mode': 'source_region_measurement',
+                  'region': {'object': query['region']['object'], 'world_box_m': box}}
+        selected.append(validate_scoped_measurement_arguments({**arguments, 'query': single}))
+    return {'mode': MODE, 'region': {'object': selected[0]['region']['object'],
+            'world_boxes_m': [row['region']['world_box_m'] for row in selected]},
+            'reference': selected[0]['reference'], 'requested_facts': ['surface_proximity']}
+
+
+def _single_capture(batch, row):
+    binding = dict(batch['binding'])
+    binding.pop('world_boxes_m')
+    binding['world_box_m'] = row['world_box_m']
+    capture = {'schema': 'human-eye-selective-source-region-capture-v1', 'binding': binding,
+               'region': row['region'], 'reference': batch['reference']}
+    capture['payload_sha256'] = _host_digest(capture)
+    # The batch work is shared and validated once. This transient view retains it;
+    # no synthetic expansion/transfer counters are attributed to either region.
+    capture.update(work=batch['work'], stages=batch['stages'])
+    return capture
+
+
+def validate_batch_capture(batch, target, reference, boxes, host_sha, checkpoint):
+    if (type(batch) is not dict or set(batch) != {'schema', 'binding', 'regions', 'reference', 'payload_sha256', 'work', 'stages'}
+            or batch['schema'] != 'human-eye-selective-source-region-batch-capture-v1'
+            or type(batch['binding']) is not dict or 'world_boxes_m' not in batch['binding']
+            or type(batch['regions']) is not list or len(batch['regions']) != 2
+            or _host_digest(batch['binding']['world_boxes_m']) != _host_digest(boxes)):
+        raise ValueError('source_region_batch_capture_schema')
+    if batch['payload_sha256'] != _host_digest({key: batch[key] for key in ('schema','binding','regions','reference')}):
+        raise ValueError('source_region_batch_payload_digest')
+    whole_vertices, whole_faces = _selective_mesh_arrays(batch['reference'], checkpoint)
+    complete = []
+    for index, (row, box) in enumerate(zip(batch['regions'], boxes, strict=True)):
+        if (type(row) is not dict or row.get('index') != index or type(row.get('index')) is not int
+                or _host_digest(row.get('world_box_m')) != _host_digest(box) or type(row.get('selection_stage')) is not dict):
+            raise ValueError('source_region_batch_region_binding')
+        if row.get('status') == 'complete':
+            if set(row) != {'index', 'world_box_m', 'status', 'region', 'selection_stage'}:
+                raise ValueError('source_region_batch_region_schema')
+            capture = _single_capture(batch, row)
+            _validate_selective_capture(capture, target, reference, box, host_sha, checkpoint, _batch_shared=True)
+            complete.append(row['region'])
+        elif (set(row) != {'index','world_box_m','status','reason','selection_stage'}
+                or row['status'] != 'unmeasured' or row['reason'] not in (
+                    'source_region_pair_empty_world_box', 'source_region_pair_triangle_limit')):
+            raise ValueError('source_region_batch_region_status')
+    # Even all-empty rows must validate the shared current identity/transform.
+    binding = dict(batch['binding']); binding.pop('world_boxes_m')
+    if set(binding) != {'capture_scope','document_epoch','host_source_sha256','target_selector','reference_selector',
+            'target','reference','unit','coordinate_frame','source_frame','world_matrices'}:
+        raise ValueError('source_region_batch_binding_schema')
+    from .source_region import _validate_selective_binding
+    for box in boxes:
+        _validate_selective_binding(dict(binding, world_box_m=box), target, reference, box, host_sha)
+    work = batch['work']
+    if (type(work) is not dict or type(batch['stages']) is not dict
+            or any(type(work.get(k)) is not int for k in ('candidate_objects','source_vertices','source_triangles',
+                'expanded_objects','expanded_vertices','expanded_triangles','to_mesh','triangulations',
+                'world_transforms','world_vertices_transformed'))
+            or work['candidate_objects'] < 2 or work['source_vertices'] <= 0 or work['source_triangles'] <= 0
+            or work.get('mode') not in ('resident_capture','uncached_capture')):
+        raise ValueError('source_region_batch_accounting')
+    source = work['source_vertices'], work['source_triangles']
+    ref = len(whole_vertices), len(whole_faces)
+    total = source[0]+ref[0], source[1]+ref[1]
+    valid = ((2,*total),) if work['mode']=='uncached_capture' else ((0,0,0),(1,*source),(1,*ref),(2,*total))
+    if (tuple(work[k] for k in ('expanded_objects','expanded_vertices','expanded_triangles')) not in valid
+            or any(region['source_vertex_count'] != source[0] or region['source_triangle_count'] != source[1] for region in complete)):
+        raise ValueError('source_region_batch_expansion_accounting')
+    exact = dict(transmitted_objects=2, transmitted_vertices=sum(len(r['vertices']) for r in complete)+ref[0],
+        transmitted_triangles=sum(len(r['faces']) for r in complete)+ref[1],box_vertices_scanned=2*source[0],
+        box_triangles_scan_upper_bound=2*source[1],boxes=2,region_triangle_limit=4096,reference_copies=1,acquisition_cycles=1)
+    if any(type(work.get(k)) is not int or work[k] != value for k,value in exact.items()):
+        raise ValueError('source_region_batch_shared_accounting')
+    checkpoint('source_region_batch_capture_validated')
+
+
+def measure_batch(service, session_id, query, *, include_image=False):
+    from .live_service import RequestBudgetError, span
+    if include_image is not False:
+        raise ValueError('selective_source_region_requires_no_image')
+    query = validate_batch_arguments({'query': query, 'include_image': False})
+    target, reference = query['region']['object'], query['reference']
+    boxes = query['region']['world_boxes_m']
+    if not service.config.get('enabled', True):
+        return {'status': 'disabled', 'session_id': session_id, 'routing': None}
+    capture_pair = getattr(service.host, 'capture_source_region_batch', None)
+    if not callable(capture_pair):
+        raise ValueError('source_region_batch_host_unavailable')
+    started = time.perf_counter_ns()
+    with service._request_budget(), service._read_context.lock, service._observation_scope():
+        rejected, source_check = service._read_source_identity()
+        if rejected is not None:
+            return copy.deepcopy(rejected)
+        remaining = service._check_request_budget('before_selective_source_region_batch_capture')
+        deadline_ns = time.perf_counter_ns()+int((30 if remaining is None else remaining)*1e9)
+        def checkpoint(stage):
+            service._check_request_budget(stage)
+            if time.perf_counter_ns() >= deadline_ns:
+                raise RequestBudgetError('expired', stage)
+        capture_started = time.perf_counter_ns()
+        with span('host.capture_source_region_batch', kind='host'):
+            capture = capture_pair(target, reference, boxes, deadline_ns, 64*1024*1024)
+        capture_closed = time.perf_counter_ns()
+        checkpoint('after_selective_source_region_batch_capture')
+        host_sha = getattr(service.host, '_readonly_host_source_sha256', None)
+        validate_batch_capture(capture, target, reference, boxes, host_sha, checkpoint)
+        rows = []
+        for index, (row, box) in enumerate(zip(capture['regions'], boxes, strict=True)):
+            checkpoint('before_source_region_batch_region')
+            if row['status'] != 'complete':
+                rows.append({'index': index, 'world_box_m': box, 'status': 'unmeasured', 'reason': row['reason']})
+                continue
+            value = measure_selective_region(_single_capture(capture, row), target, reference, box, host_sha,
+                                              checkpoint, _batch_shared=True)
+            value['session_id'] = session_id
+            service._bind_read_result(value, source_check)
+            single_query = {'region': {'object': target, 'world_box_m': box}, 'reference': reference}
+            try:
+                published = project_scoped_measurement(value, single_query)
+            except ValueError as error:
+                rows.append({'index': index, 'world_box_m': box, 'status': 'unmeasured', 'reason': str(error)})
+            else:
+                rows.append(dict(published, index=index))
+            checkpoint('after_source_region_batch_region')
+        checkpoint('before_selective_source_region_batch_result')
+        closed = time.perf_counter_ns()
+        result = {'schema': 'human-eye-source-region-scoped-batch-v1', 'status':
+                    'complete' if all(r['status']=='complete' for r in rows) else
+                    'partial' if any(r['status']=='complete' for r in rows) else 'unmeasured',
+            'regions': rows, 'binding': copy.deepcopy(capture['binding']), 'frames': [],
+            'read_only': True, 'execution_authority': False, 'session_id': session_id,
+            'work': {'host_capture': capture['work'], 'region_count': 2},
+            'stages': {'host_read': {'started_ns': capture_started, 'closed_ns': capture_closed,
+                                   'elapsed_ns': capture_closed-capture_started},
+                       'service_total': {'started_ns': started, 'closed_ns': closed, 'elapsed_ns': closed-started}}}
+        service._bind_read_result(result, source_check)
+        service.record_event('observe', session_id=session_id, observation_mode=MODE, task_work=result['work'])
+        return result
+
+
+def publish_batch(value):
+    if (value.get('schema') != 'human-eye-source-region-scoped-batch-v1' or value.get('read_only') is not True
+            or value.get('execution_authority') is not False or value.get('frames') != []):
+        raise ValueError('source_region_batch_current_capture_unavailable')
+    return {key: value[key] for key in ('schema','status','regions','binding','read_only','execution_authority')}
