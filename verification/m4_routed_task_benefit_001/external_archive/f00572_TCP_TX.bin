-discovered-surface-coverage-v1','source':'explicitly labelled capture replay','image_columns':['view','reference'],'images':[[row[0],row[1]] for row in obs['images']['rows']],'row_columns':['region_index_join_to_active_observation_world_corners','source_triangle_index_ranges_inclusive','status','remaining_reason','evidence_image_index_surface_pixels_boundary_pixels_owned_anchor'],'rows':coverage_rows,'unsupported':unsupported,'finite_pool':[(view['name'],view['direction_rational']) for view in cameras['views']],'completeness_evidence':'Current-session active_observation complete witnesses; native SCENE pixel identity and contrast independently checked. Exact rational shared-edge planar rectangular component discovery matches every active region one-to-one.','remaining_summary':{'no_front_facing_camera':22,'positive_area_occlusion_every_camera':1,'unfinished_inspectable':0}}\nprint(json.dumps(record,separators=(',',':')))"}}}}}
