in surfaces if s['id']==int(buffers['SCENE']['surface_ids'][247,109]) or s['center'] in [(Fraction(0),)*3,(Fraction(5,32),Fraction(-5,32),Fraction(237,2048))]])\nprint('remainder',remainder,[[verts[i] for i in faces[j]] for ids in remainder for j in ids])\n"}}}
