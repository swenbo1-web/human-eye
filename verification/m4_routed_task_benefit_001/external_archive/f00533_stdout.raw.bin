{"type":"item.started","item":{"id":"item_8","type":"mcp_tool_call","server":"arm_engine","tool":"execute_python","arguments":{"code":"from collections import defaultdict\nobj=geometry['objects'][0]\nvertices=[tuple(Fraction(value) for value in vertex) for vertex in obj['vertices']]\nfaces=obj['triangles']\ndef sub(a,b): return tuple(x-y for x,y in zip(a,b))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])\ndef dot(a,b): return sum(x*y for x,y in zip(a,b))\nplanes=[]; edges=defaultdict(list)\nfor face_index,face in enumerate(faces):\n points=[vertices[index] for index in face]\n normal=cross(sub(points[1],points[0]),sub(points[2],points[0]))\n scale=max(map(abs,normal))\n plane=tuple(value/scale for value in normal)+(dot(normal,points[0])/scale,) if scale else None\n planes.append(plane)\n for offset in range(3): edges[tuple(sorted((points[offset],points[(offset+1)%3])))].append(face_index)\nadjacency=[set() for face in faces]\nfor incident in edges.values():\n for first in incident:\n  for second in incident:\n   if first!=second and planes[first] is not None and planes[first]==planes[second]: adjacency[first].add(second)\ncomponents=[]; unseen=set(range(len(faces)))\nwhile unseen:\n seed=min(unseen); unseen.remove(seed); component=[seed]; queue=[seed]\n while queue:\n  for neighbor in adjacency[queue.pop()] & unseen:\n   unseen.remove(neighbor);component.append(neighbor);queue.append(neighbor)\n components.append(sorted(component))\nsurfaces=[];unsupported=[]\nfor component in components:\n boundary=defaultdict(list)\n for face_index in component:\n  points=[vertices[index] for index in faces[face_index]]\n  for offset in range(3):boundary[tuple(sorted((points[offset],points[(offset+1)%3])))].append((points[offset],points[(offset+1)%3]))\n boundary_edges=[items[0] for items in boundary.values() if len(items)==1]\n consistent=all(len(items)==1 or (len(items)==2 and items[0]==items[1][::-1]) for items in boundary.values())\n following={a:b for a,b in boundary_edges}; loop=[]\n if boundary_edges:\n  start=boundary_edges[0][0]; current=start\n  while current not in loop and current in following:\n   loop.append(current);current=following[current]\n  closed=current==start and len(loop)==len(boundary_edges)\n else:closed=False\n corners=[point for index,point in enumerate(loop) if cross(sub(point,loop[index-1]),sub(loop[(index+1)%len(loop)],point))!=(0,0,0)]\n rectangle=closed and consistent and len(corners)==4 and all(dot(sub(corners[(index+1)%4],corners[index]),sub(corners[(index+2)%4],corners[(index+1)%4]))==0 for index in range(4))\n if rectangle:\n  center=tuple(sum(point[axis] for point in corners)/4 for axis in range(3))\n  match=[index for index,r in enumerate(regions) if tuple(map(Fraction,r['center_world_m']))==center and tuple(map(Fraction,r['front_direction_world']))==planes[component[0]][:3]]\n  surfaces.append({'source_triangle_indices':component,'corners':[[float(value) for value in point] for point in corners],'region_indices':match})\n else:unsupported.append({'source_triangle_indices':component,'reason':'nonrectangular_or_degenerate_component'})\nprint('discovery',len(surfaces),'unsupported',unsupported,'matches',[s['region_indices'] for s in surfaces if len(s['region_indices'])!=1])\nprint(render_views(['SCENE'],include_images=False))"},"result":null,"error":null,"status":"in_progress"}}
