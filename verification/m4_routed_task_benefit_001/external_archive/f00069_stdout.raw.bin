8]],'status':'unsupported_nonrectangular_triangle'}],'surfaces':coverage_rows}\nprint(json.dumps(coverage_facts,separators=(',',':')))"},"result":{"content":[{"type":"text","text":"{\"stdout\": \"{\\\"source\\\":\\\"explicitly labelled capture replay; current-session observations only\\\",\\\"object\\\":\\\"QA_Joined\\\",\\\"indexing\\\":\\\"zero-based source triangles, inclusive ranges; IDs independently assigned in source component order\\\",\\\"pool\\\":{\\\"SCENE\\\":\\\"image-01\\\",\\\"TOP\\\":\\\"image-02\\\",\\\"LEFT\\\":\\\"image-03\\\",\\\"RIGHT\\\":\\\"image-04\\\",\\\"FRONT\\\":\\\"image-05\\\",\\\"BACK\\\":\\\"image-06\\\"},\\\"method\\\":\\\"Exact rational coplanar consistently wound shared-edge components and rectangular boundaries; exact projected triangle clipping including strict positive depth separation, positive projected area only; actual winning triangle IDs merged before RGB boundary counting; both endpoints marked, target-owned unique endpoints counted. All supported corners inside all six frusta.\\\",\\\"observed_count\\\":115,\\\"remaining_count\\\":23,\\\"unfinished_feasible_count\\\":0,\\\"unsupported\\\":[{\\\"source_triangle_indices\\\":[48],\\\"world_corners\\\":[[\\\"-9/64\\\",\\\"-11/64\\\",\\\"1/32\\\"],[\\\"-7/64\\\",\\\"-11/64\\\",\\\"1/32\\\"],[\\\"-9/64\\\",\\\"-9/64\\\",\\\"1/32\\\"]],\\\"status\\\":\\\"unsupported_nonrectangular_triangle\\\"}],\\\"surfaces\\\":[{\\\"id\\\":0,\\\"source_triangle_ranges_inclusive\\\":[[0,1]],\\\"status\\\":\\\"observed_complete_readable\\\",\\\"evidence\\\":[{\\\"view\\\":\\\"LEFT\\\",\\\"ref\\\":\\\"image-03\\\",\\\"pixels\\\":39,\\\"boundary_pixels\\\":39}]},{\\\"id\\\":1,\\\"source_triangle_ranges_inclusive\\\":[[2,3]],\\\"status\\\":\\\"observed_complete_readable\\\",\\\"evidence\\\":[{\\\"view\\\":\\\"SCENE\\\",\\\"ref\\\":\\\"image-01\\\",\\\"pixels\\\":19,\\\"boundary_pixels\\\":19},{\\\"view\\\":\\\"RIGHT\\\",\\\"ref\\\":\\\"image-04\\\",\\\"pixels\\\":39,\\\"boundary_pixels\\\":39}]},{