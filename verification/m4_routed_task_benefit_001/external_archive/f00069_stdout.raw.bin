{"type":"item.started","item":{"id":"item_8","type":"mcp_tool_call","server":"arm_engine","tool":"execute_python","arguments":{"code":"from collections import defaultdict\nobj=geometry['objects'][0]\nverts=[tuple(Fraction(x) for x in v) for v in obj['vertices']]\nfaces=obj['triangles']\ndef sub(a,b): return tuple(x-y for x,y in zip(a,b))\ndef dot(a,b): return sum(x*y for x,y in zip(a,b))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])\nplanes=[]; edges=defaultdict(list); deg=[]\nfor idx,f in enumerate(faces):\n    points=[verts[k] for k in f]; normal=cross(sub(points[1],points[0]),sub(points[2],points[0]))\n    if not any(normal): planes.append(None); deg.append(idx); continue\n    scale=abs(next(x for x in normal if x)); normal=tuple(x/scale for x in normal)\n    planes.append((normal,dot(normal,points[0])))\n    for start,end in zip(points,points[1:]+points[:1]): edges[tuple(sorted((start,end)))].append((idx,start,end))\nparents=list(range(len(faces)))\ndef root(index):\n    while parents[index]!=index:\n        parents[index]=parents[parents[index]]; index=parents[index]\n    return index\nfor entries in edges.values():\n    for first in entries:\n        for second in entries:\n            if first[0]<second[0] and planes[first[0]]==planes[second[0]] and first[1]==second[2] and first[2]==second[1]: parents[root(second[0])]=root(first[0])\ngroups=defaultdict(list)\nfor idx in range(len(faces)): groups[root(idx)].append(idx)\nsurfaces=[]; unsupported=[]\nfor indices in groups.values():\n    if planes[indices[0]] is None: unsupported.append({'triangles':indices,'reason':'degenerate'}); continue\n    edge_counts=defaultdict(list)\n    for idx in indices:\n        points=[verts[k] for k in faces[idx]]\n        for start,end in zip(points,points[1:]+points[:1]): edge_counts[tuple(sorted((start,end)))].append((start,end))\n    boundary=[entry[0] for entry in edge_counts.values() if len(entry)==1]\n    valid=all(len(entry)<=2 for entry in edge_counts.values())\n    successors={start:end for start,end in boundary}; loop=[]\n    if boundary:\n        current=boundary[0][0]\n        while current not in loop and current in successors:\n            loop.append(current); current=successors[current]\n        valid &= len(loop)==len(boundary) and current==loop[0] and len(successors)==len(boundary)\n    else: valid=False\n    changed=True\n    while changed and len(loop)>3:\n        changed=False\n        for corner in range(len(loop)):\n            if not any(cross(sub(loop[corner],loop[corner-1]),sub(loop[(corner+1)%len(loop)],loop[corner]))): loop.pop(corner); changed=True; break\n    valid &= len(loop)==4\n    if valid:\n        sides=[sub(loop[(k+1)%4],loop[k]) for k in range(4)]\n        valid &= all(dot(sides[k],sides[(k+1)%4])==0 for k in range(4))\n        total_area=sum((cross(sub(verts[faces[idx][1]],verts[faces[idx][0]]),sub(verts[faces[idx][2]],verts[faces[idx][0]])) for idx in indices),start=np.array([Fraction(0)]*3,dtype=object))\n        valid &= tuple(total_area)==tuple(2*x for x in cross(sides[0],sides[1]))\n    if valid: surfaces.append({'id':len(surfaces),'triangles':indices,'corners':loop,'normal':planes[indices[0]][0],'center':tuple(sum(p[k] for p in loop)/4 for k in range(3))})\n    else: unsupported.append({'triangles':indices,'reason':'nonrectangular or invalid boundary/topology'})\nprint('components',len(groups),'supported',len(surfaces),'unsupported',len(unsupported),'degenerate',len(deg))\nprint('triangle counts',collections.Counter(len(s['triangles']) for s in surfaces))\nprint('unsupported',unsupported[:10])"},"result":null,"error":null,"status":"in_progress"}}
