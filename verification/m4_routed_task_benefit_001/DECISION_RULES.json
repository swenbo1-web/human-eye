{
  "quality_gate": {
    "N_fully_qualified": 3,
    "P_fully_qualified": 3,
    "P_actual_current_product_fact_use": 3,
    "source_and_terminal_binding_required": true
  },
  "paired_time": {
    "metric": "same independently wrapped full per-slot outer wall",
    "median_P_over_N_max": 0.9,
    "minimum_P_faster_pairs": 2,
    "pairs": [
      [
        "N1",
        "P1"
      ],
      [
        "N2",
        "P2"
      ],
      [
        "N3",
        "P3"
      ]
    ],
    "failed_completion_cannot_be_speed_denominator": true
  },
  "usage": {
    "metric": "same-source CLI raw input+output sum",
    "P_sum_max": "N_sum",
    "cached_and_reasoning_are_subsets_not_added": true,
    "incomplete_usage": "token_net_benefit_unmeasured; no total-cost-nonincrease claim"
  },
  "positive_signal_requires": "quality gate AND comparable complete usage AND paired_time AND usage AND no missing required evidence/pre-timing P work",
  "no_extra_samples": true,
  "no_threshold_or_prompt_tuning_after_start": true,
  "no_p95_or_significance_claim": true
}
