{"jsonrpc": "2.0", "id": "initialize", "result": {"protocolVersion": "2025-03-26", "capabilities": {"tools": {"listChanged": false}}, "serverInfo": {"name": "human-eye-live-spatial", "version": "9.7.2"}, "_meta": {"human_eye": {"schema_version": "1.0", "base_version": "9.7.2", "implementation_revision": "v26-surface-scan-pair-cache-20261112", "build_id": "sha256:9f2c5ca150f968841b64f4d4eda89313069453853c877ba21b6a262999e29a61", "build_id_basis": "runtime_source_bytes_and_version_metadata", "source_sha256": "9f2c5ca150f968841b64f4d4eda89313069453853c877ba21b6a262999e29a61", "source_kind": "installed_distribution", "distribution_version": "9.7.2+m4.target.camera.reliability.r1", "source_hash_exclusions": [], "protocol_version": "2025-03-26", "mode": "live", "capabilities": {"declared_only": true, "host_connection": "not_checked", "live_host_required": true, "scene_observation": true, "surface_scan": true, "surface_scan_scope": "up_to_256_independent_static_triangle_meshes", "guarded_rigid_transform": true, "bounded_clearance_segment": true, "clearance_segment_support": "exact_world_axis_boxes_or_explicit_original_support_triangle", "segment_inflight_cancel_supported": false, "task_correlated_request_evidence": true, "observation_scene_transport": true, "optional_observation_task_brief": true, "operation_local_observation_reuse": true, "observation_reuse_scope": "paired_fresh_capture_128_vertices_or_8_meshes", "layered_capability_diagnostics": true, "execution_scope": "independent_static_rigid_mesh_endpoint_geometry", "swept_path_certified": false, "model_task_benefit_certified": false}, "source_file_count": 141, "production_mode": true, "identity_check": {"compatible": true, "pins_requested": true, "reasons": [], "expected": {"source_sha256": "9f2c5ca150f968841b64f4d4eda89313069453853c877ba21b6a262999e29a61"}, "actual": {"base_version": "9.7.2", "build_id": "sha256:9f2c5ca150f968841b64f4d4eda89313069453853c877ba21b6a262999e29a61", "implementation_revision": "v26-surface-scan-pair-cache-20261112", "mode": "live", "protocol_version": "2025-03-26", "source_kind": "installed_distribution", "source_sha256": "9f2c5ca150f968841b64f4d4eda89313069453853c877ba21b6a262999e29a61"}, "authorization": "identity_comparison_only"}}}}}
{"jsonrpc": "2.0", "id": "tools", "result": {"tools": [{"name": "human_eye_scene_observe", "description": "Current Blender facts. Directory query={mode:directory} with include_image=false returns tight evaluated world bounds, AABB centers and an independent directory binding. Task set example: {\"include_image\":false,\"query\":{\"mode\":\"task\",\"target\":{\"name\":\"A\"},\"candidates\":[{\"name\":\"B\"}],\"requested_facts\":[\"closed_solid_relation\",\"surface_proximity\"]}}. Opt in to spatial_relation and surface_proximity for support-certified separation with closed-classification fallback. Unknown/duplicate rows remain. Complete penetration/nearest-separated sets require all relevant evidence; otherwise only known subsets are reported. Legacy objects pair/aabb supported. Global surface_nearest instead uses one query.objects selector without focal_id, or focal_id with query={\"mode\":\"surface_nearest\"}; session_id and include_image=false required. Complete means global nearest; partial means best-known. scene_revision/fingerprint bind this capture/source/revision; runtime_source_sha256 identifies code. Scene edits expire observations. Goals are caller criteria. For all current scene mesh pairs use query={\"mode\":\"surface_scan\",\"threshold_m\":0.002}. This text-only scan includes hidden meshes, needs no selectors, includes threshold equality and reports coverage. Its unsigned triangle-surface distance describes surface proximity. Solid relations require separate facts. For surface_scan, omitted response_detail or brief returns a versioned compact table with readable names, object-table references, original distance_m and derived distance_mm. Explicit full returns detailed current evidence with witnesses. Combine observations using their scene/source binding. For finite active observation use {\"query\":{\"mode\":\"active_observation\"},\"include_image\":true}; add query.objects=[{\"name\":\"Target\"}] for one visual target with scene occluders. Returns brief source-bound region locations, owned-pixel anchors and remaining unknowns with up to six 512px native PNGs. Explicit response_detail=full includes diagnostics.", "inputSchema": {"type": "object", "properties": {"task_instruction": {"type": "string"}, "focal_id": {"type": "string", "minLength": 1}, "reference_id": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1}, "goal": {"type": "object", "description": "Optional caller-supplied task criteria, evaluated separately from execution. Omitted object IDs bind to the selected observation/action pair. These criteria are not independently verified as the human user's intent.", "properties": {"focal_id": {"type": "string", "minLength": 1}, "reference_id": {"type": "string", "minLength": 1}, "target_clearance_m": {"type": "number", "minimum": 0}, "clearance_tolerance_m": {"type": "number", "minimum": 0}, "target_focal_pivot_world_m": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "position_tolerance_m": {"type": "number", "minimum": 0}, "max_contact_normal_angle_deg": {"type": "number", "minimum": 0, "maximum": 180}, "max_tangent_yaw_mismatch_deg": {"type": "number", "minimum": 0, "maximum": 180}, "yaw_symmetry_order": {"type": "integer", "enum": [1, 2, 4]}}, "anyOf": [{"required": ["target_clearance_m"]}, {"required": ["target_focal_pivot_world_m"]}, {"required": ["max_contact_normal_angle_deg"]}, {"required": ["max_tangent_yaw_mismatch_deg"]}], "dependentRequired": {"target_clearance_m": ["clearance_tolerance_m"], "clearance_tolerance_m": ["target_clearance_m"], "target_focal_pivot_world_m": ["position_tolerance_m"], "position_tolerance_m": ["target_focal_pivot_world_m"]}, "additionalProperties": false}, "query": {"type": "object", "description": "Selectors use name OR id. Legacy exact_pairs/nearest/top1 use object_ids/max_exact_pairs. nearest needs complete exact nonpenetrating order; top1 may prune by strict outward bounds and reports ties. Unknown/budget-limited proofs do not certify nearest.", "properties": {"mode": {"type": "string", "enum": ["directory", "task", "surface_nearest", "surface_scan", "overview", "exact_pairs", "nearest", "top1", "mesh_structure", "mesh_surface", "active_observation"]}, "objects": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}, "minItems": 1, "maxItems": 4, "description": "active_observation: one visual target. Legacy task: aabb 1..4 selectors; pair facts two ordered A to B."}, "target": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}, "candidates": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}, "minItems": 1, "maxItems": 3, "description": "1..3 explicit candidates in request order; one capture with target. Requires surface_proximity with spatial_relation or closed_solid_relation. Optional aabb supplies bounds."}, "requested_facts": {"type": "array", "items": {"type": "string", "enum": ["aabb", "center_delta", "axis_gap", "surface_clearance", "solid_relation", "nearest_witness", "pair_relation", "surface_proximity", "closed_solid_relation", "spatial_relation"]}, "minItems": 1, "uniqueItems": true, "description": "task: spatial_relation proves strict full-referenced-vertex support separation or uses closed-shell classification, with geometry_scope identifying the performed proof. closed_solid_relation is zero-tolerance separated/touching/penetrating (positive-volume overlap, including containment) for represented connected closed triangle shells; invalid/ambiguous is unknown. surface_proximity independently gives nonnegative triangle-surface distance, original world witness points and positive-distance A-to-B direction; zero-distance direction is inapplicable. Boundary/nonmanifold counts do not certify solids. Penetrating/contained distances are not separated gaps. pair_relation's escape of A is not surface distance, nearest direction or minimum depth."}, "geometry": {"type": "object", "description": "Opt-in geometry from the original relation bindings. Vertices use world metres; captured triangles are optional.", "properties": {"objects": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}, "oneOf": [{"required": ["id"]}, {"required": ["name"]}], "additionalProperties": false}, "minItems": 1, "maxItems": 4}, "include_triangles": {"type": "boolean", "default": false}}, "required": ["objects"], "additionalProperties": false}, "operation": {"type": "string", "enum": ["diagnose", "patch", "reference", "restore_preview", "reference_patch"], "description": "Registered target reads. mesh_structure: diagnose text or patch images. mesh_surface (local opt-in): diagnose/reference/restore_preview require include_image=false; reference_patch uses a returned opaque patch_ref and optional native images. References are locally trusted; previews do not execute; the original task budget applies."}, "request_id": {"type": "string", "minLength": 1, "maxLength": 128}, "near_m": {"type": "number", "minimum": 0, "maximum": 0.001}, "threshold_m": {"type": "number", "minimum": 0}, "reference_ref": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "indices": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 4095}, "minItems": 1, "maxItems": 64, "uniqueItems": true}, "patch_ref": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "task_ref": {"type": "string", "pattern": "^[a-f0-9]{32}$", "description": "Trusted begin handoff, required in local lifecycle mode; selects the active generation without creating or renewing a task."}, "object_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 255, "uniqueItems": true}, "label_object_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 6, "uniqueItems": true, "description": "Current full IDs for image annotation, separate from measurement object_ids: up to six related labels plus A/B. Missing pair/image, occlusion or undersampling is explicit; display only."}, "max_exact_pairs": {"type": "integer", "minimum": 1, "maximum": 255}, "alignment_evidence": {"type": "boolean", "default": true, "description": "False omits optional face angles and requires include_image=false; strict distance, host rigid-frame and action checks remain."}, "support_plane_discovery": {"type": "object", "additionalProperties": false, "description": "Read-only discovery of bounded original support-plane selectors for the current focal/reference pair. Omit direction for geometry only; no action direction is invented.", "properties": {"direction_world": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "max_candidates": {"type": "integer", "minimum": 1, "maximum": 6, "default": 4}}}, "native_visual": {"type": "object", "description": "Display policy only; never execution permission. Auto uses a negotiated read-only native host, otherwise the analytical projection. Projection skips negotiation; multiscale requires support. Labels and contact sections require projection.", "properties": {"mode": {"type": "string", "enum": ["auto", "projection", "multiscale"]}, "view": {"type": "string", "enum": ["SCENE", "XY", "XZ"]}}, "additionalProperties": false}, "visual_diagnostic": {"type": "string", "enum": ["contact_section"], "description": "Analytical full-mesh contact section beside natural views; not visibility evidence or action permission."}}, "allOf": [{"if": {"properties": {"mode": {"const": "active_observation"}}, "required": ["mode"]}, "then": {"properties": {"mode": {}, "objects": {"maxItems": 1}}, "additionalProperties": false}}, {"if": {"properties": {"mode": {"const": "directory"}}, "required": ["mode"]}, "then": {"properties": {"mode": {}}, "additionalProperties": false}}, {"if": {"properties": {"mode": {"const": "surface_nearest"}}, "required": ["mode"]}, "then": {"properties": {"mode": {}, "objects": {"maxItems": 1}}, "additionalProperties": false}}, {"if": {"properties": {"mode": {"const": "surface_scan"}}, "required": ["mode"]}, "then": {"required": ["threshold_m"], "properties": {"mode": {}, "threshold_m": {}}, "additionalProperties": false}, "else": {"properties": {"threshold_m": {"exclusiveMinimum": 0, "maximum": 0.01}}}}, {"if": {"anyOf": [{"properties": {"mode": {"const": "task"}}, "required": ["mode"]}, {"required": ["target"]}, {"required": ["candidates"]}]}, "then": {"required": ["mode", "requested_facts"], "properties": {"mode": {"const": "task"}}, "oneOf": [{"required": ["objects"], "properties": {"target": false, "candidates": false}}, {"required": ["target", "candidates"], "additionalProperties": false, "properties": {"mode": {}, "target": {}, "candidates": {}, "geometry": {}, "requested_facts": {"items": {"enum": ["closed_solid_relation", "spatial_relation", "surface_proximity", "aabb"]}, "allOf": [{"contains": {"const": "surface_proximity"}}, {"anyOf": [{"contains": {"const": "closed_solid_relation"}}, {"contains": {"const": "spatial_relation"}}]}]}}}]}}, {"if": {"required": ["geometry"]}, "then": {"required": ["mode", "target", "candidates"], "properties": {"mode": {"const": "task"}}}}], "additionalProperties": false}, "include_image": {"type": "boolean", "default": true, "description": "False returns text evidence without rendering. surface_scan defaults to false and accepts only false. mesh_structure diagnose requires false and reads only the registered target raw mesh; patch may explicitly request images. Other observation modes retain default true."}, "task_context": {"type": "object", "additionalProperties": false, "required": ["task_id", "task_run_id"], "properties": {"task_id": {"type": "string", "minLength": 1, "maxLength": 128}, "task_run_id": {"type": "string", "minLength": 1, "maxLength": 128}}}, "scene_delta": {"type": "object", "additionalProperties": false, "description": "Optional observation-only snapshot transport. Empty object asks for full resync; a complete base revision and SHA256 enables a delta when worthwhile.", "properties": {"base_revision": {"type": "string", "minLength": 1, "maxLength": 256}, "base_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "dependentRequired": {"base_revision": ["base_fingerprint"], "base_fingerprint": ["base_revision"]}}, "response_detail": {"type": "string", "enum": ["full", "brief"], "description": "Optional display projection. surface_scan defaults to brief: a versioned table preserves all delivered matches, raw metre distances, derived millimetres, identities, scopes and unknowns. distance_mm uses a number, or an exact decimal string when binary64 millimetres overflow. Its object table covers matched endpoints. Full requests a new current observation with detailed witnesses; combine observations by scene/source binding. active_observation also defaults to brief, with all objects, region unknowns, actual pixel facts and native image references; full retains diagnostics. Other modes default to full; their brief omits named camera/raster diagnostics while preserving measurements and native images. Errors and unsupported projections retain the detailed response."}}, "allOf": [{"if": {"required": ["query"], "properties": {"query": {"required": ["mode"], "properties": {"mode": {"const": "active_observation"}}}}}, "then": {"properties": {"task_instruction": {"const": ""}}, "not": {"anyOf": [{"required": ["focal_id"]}, {"required": ["reference_id"]}, {"required": ["goal"]}, {"required": ["scene_delta"]}]}}}, {"if": {"required": ["query"], "properties": {"query": {"required": ["mode"], "properties": {"mode": {"const": "directory"}}}}}, "then": {"required": ["include_image"], "properties": {"include_image": {"const": false}, "task_instruction": {"const": ""}}, "not": {"anyOf": [{"required": ["focal_id"]}, {"required": ["reference_id"]}, {"required": ["goal"]}, {"required": ["scene_delta"]}]}}}, {"if": {"required": ["query"], "properties": {"query": {"required": ["mode"], "properties": {"mode": {"const": "surface_nearest"}}}}}, "then": {"required": ["session_id", "include_image"], "properties": {"include_image": {"const": false}}, "oneOf": [{"required": ["focal_id"], "properties": {"query": {"not": {"required": ["objects"]}}}}, {"not": {"required": ["focal_id"]}, "properties": {"query": {"required": ["objects"]}}}]}}, {"if": {"required": ["query"], "properties": {"query": {"required": ["mode"], "properties": {"mode": {"const": "surface_scan"}}}}}, "then": {"properties": {"include_image": {"const": false}, "response_detail": {"default": "brief"}}, "not": {"anyOf": [{"required": ["focal_id"]}, {"required": ["reference_id"]}, {"required": ["goal"]}, {"required": ["scene_delta"]}]}}}, {"if": {"required": ["query"], "properties": {"query": {"required": ["mode"], "properties": {"mode": {"enum": ["surface_scan", "active_observation"]}}}}}, "then": {"properties": {"response_detail": {"default": "brief"}}}, "else": {"properties": {"response_detail": {"default": "full"}}}}, {"if": {"required": ["query"], "properties": {"query": {"required": ["mode"], "properties": {"mode": {"const": "task"}}}}}, "then": {"required": ["include_image"], "properties": {"include_image": {"const": false}}, "not": {"anyOf": [{"required": ["focal_id"]}, {"required": ["reference_id"]}, {"required": ["goal"]}, {"required": ["scene_delta"]}]}}}], "additionalProperties": false}}, {"name": "human_eye_transform", "description": "Apply a guarded world-space rigid transform to the focal Blender object automatically preparing a fresh engine observation before its mandatory check. Translation is in metres; rotation is XYZ Euler degrees about the object pivot. The service checks the current revision and endpoint geometry, executes only accepted actions, and reads the actual scene back. An optional caller-supplied goal checks the actual result separately from execution verification. This does not certify a swept path or independently verify the caller's intent.", "inputSchema": {"type": "object", "properties": {"action": {"type": "object", "properties": {"focal_id": {"type": "string", "minLength": 1}, "reference_id": {"type": "string", "minLength": 1}, "translation": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "rotation_euler_deg": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}}, "required": ["focal_id", "reference_id"], "anyOf": [{"required": ["translation"]}, {"required": ["rotation_euler_deg"]}], "additionalProperties": false}, "session_id": {"type": "string", "minLength": 1}, "goal": {"type": "object", "description": "Optional caller-supplied task criteria, evaluated separately from execution. Omitted object IDs bind to the selected observation/action pair. These criteria are not independently verified as the human user's intent.", "properties": {"focal_id": {"type": "string", "minLength": 1}, "reference_id": {"type": "string", "minLength": 1}, "target_clearance_m": {"type": "number", "minimum": 0}, "clearance_tolerance_m": {"type": "number", "minimum": 0}, "target_focal_pivot_world_m": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "position_tolerance_m": {"type": "number", "minimum": 0}, "max_contact_normal_angle_deg": {"type": "number", "minimum": 0, "maximum": 180}, "max_tangent_yaw_mismatch_deg": {"type": "number", "minimum": 0, "maximum": 180}, "yaw_symmetry_order": {"type": "integer", "enum": [1, 2, 4]}}, "anyOf": [{"required": ["target_clearance_m"]}, {"required": ["target_focal_pivot_world_m"]}, {"required": ["max_contact_normal_angle_deg"]}, {"required": ["max_tangent_yaw_mismatch_deg"]}], "dependentRequired": {"target_clearance_m": ["clearance_tolerance_m"], "clearance_tolerance_m": ["target_clearance_m"], "target_focal_pivot_world_m": ["position_tolerance_m"], "position_tolerance_m": ["target_focal_pivot_world_m"]}, "additionalProperties": false}, "task_context": {"type": "object", "additionalProperties": false, "required": ["task_id", "task_run_id"], "properties": {"task_id": {"type": "string", "minLength": 1, "maxLength": 128}, "task_run_id": {"type": "string", "minLength": 1, "maxLength": 128}}}}, "required": ["action"], "additionalProperties": false}}, {"name": "human_eye_connection_status", "description": "Read the live service configuration and connection status without changing the scene.", "inputSchema": {"type": "object", "properties": {}, "additionalProperties": false}}, {"name": "human_eye_clearance_segment", "description": "Preview or execute a finite target-clearance segment. Legacy requests use exact world-axis boxes with an explicit signed world axis. Explicit solver=support_plane requests select an original reference triangle and a world translation direction; exact finite-plane certificates restrict their supported convex-mesh domain. Supply object IDs, target and tolerance; the engine computes translations and may correct confirmed residuals within the declared budget. execute defaults to false. Reuse the same request_id to retrieve a historical receipt, never to repeat motion. Every real step retains fresh geometry/precision checks and actual readback. Endpoint only; no swept path or in-flight cancellation is certified.", "inputSchema": {"type": "object", "additionalProperties": false, "properties": {"session_id": {"type": "string", "minLength": 1}, "request_id": {"type": "string", "minLength": 1}, "request": {"type": "object", "additionalProperties": false, "description": "A bounded goal request, never execution permission. Use the legacy explicit world-axis box constraint, or solver=support_plane with an explicitly selected original reference triangle and world direction. Each actual step still needs fresh whole-scene checks and readback.", "required": ["focal_id", "reference_id", "target_clearance_m", "clearance_tolerance_m"], "properties": {"focal_id": {"type": "string", "minLength": 1, "maxLength": 256}, "reference_id": {"type": "string", "minLength": 1, "maxLength": 256}, "axis": {"type": "string", "enum": ["+x", "-x", "+y", "-y", "+z", "-z"]}, "target_clearance_m": {"type": "number", "minimum": 0}, "clearance_tolerance_m": {"type": "number", "minimum": 0}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4}, "max_step_translation_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.01}, "max_total_translation_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 4, "default": 0.04}, "max_duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30, "default": 5}, "reference_triangle_index": {"type": "integer", "minimum": 0}, "direction_world": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "solver": {"type": "string", "enum": ["support_plane"]}, "selection_binding": {"type": "object", "additionalProperties": false, "required": ["scene_revision", "scene_fingerprint", "focal_id", "reference_id"], "description": "Initial captured-scene freshness and pair binding, never execution authority or verified user intent. Later steps retain their separate fresh checks.", "properties": {"scene_revision": {"type": "string", "minLength": 1, "maxLength": 256}, "scene_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "focal_id": {"type": "string", "minLength": 1, "maxLength": 256}, "reference_id": {"type": "string", "minLength": 1, "maxLength": 256}}}}, "oneOf": [{"type": "object", "additionalProperties": false, "required": ["focal_id", "reference_id", "axis", "target_clearance_m", "clearance_tolerance_m"], "description": "A bounded goal request, never an execution permission. Version one supports exact world-axis box faces only. Axis points from reference toward focal; each correction may move either way along that axis.", "properties": {"focal_id": {"type": "string", "minLength": 1, "maxLength": 256}, "reference_id": {"type": "string", "minLength": 1, "maxLength": 256}, "axis": {"type": "string", "enum": ["+x", "-x", "+y", "-y", "+z", "-z"]}, "target_clearance_m": {"type": "number", "minimum": 0}, "clearance_tolerance_m": {"type": "number", "minimum": 0}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4}, "max_step_translation_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.01}, "max_total_translation_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 4, "default": 0.04}, "max_duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30, "default": 5}}}, {"type": "object", "additionalProperties": false, "required": ["focal_id", "reference_id", "solver", "reference_triangle_index", "direction_world", "target_clearance_m", "clearance_tolerance_m"], "properties": {"focal_id": {"type": "string", "minLength": 1, "maxLength": 256}, "reference_id": {"type": "string", "minLength": 1, "maxLength": 256}, "reference_triangle_index": {"type": "integer", "minimum": 0}, "direction_world": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "target_clearance_m": {"type": "number", "minimum": 0}, "clearance_tolerance_m": {"type": "number", "minimum": 0}, "max_step_translation_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.01}, "max_total_translation_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 4, "default": 0.04}, "solver": {"type": "string", "enum": ["support_plane"]}, "selection_binding": {"type": "object", "additionalProperties": false, "required": ["scene_revision", "scene_fingerprint", "focal_id", "reference_id"], "description": "Initial captured-scene freshness and pair binding, never execution authority or verified user intent. Later steps retain their separate fresh checks.", "properties": {"scene_revision": {"type": "string", "minLength": 1, "maxLength": 256}, "scene_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "focal_id": {"type": "string", "minLength": 1, "maxLength": 256}, "reference_id": {"type": "string", "minLength": 1, "maxLength": 256}}}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4}, "max_duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30, "default": 5}}}]}, "execute": {"type": "boolean", "default": false}, "include_image": {"type": "boolean", "default": false}, "task_context": {"type": "object", "additionalProperties": false, "required": ["task_id", "task_run_id"], "properties": {"task_id": {"type": "string", "minLength": 1, "maxLength": 128}, "task_run_id": {"type": "string", "minLength": 1, "maxLength": 128}}}, "response_detail": {"type": "string", "enum": ["full", "brief"], "default": "full", "description": "Optional endpoint display encoding. Brief preserves all receipt facts, diagnostics and native PNG bytes using exact references within this same result. The embedded JSON context is represented by its decoded values, not original string formatting. Historical, unsupported, conflicting or insufficiently smaller results retain full. This display option grants no execution authority."}}, "required": ["request_id", "request"]}}, {"name": "human_eye_arm_twist_observe", "description": "Read an explicitly selected Blender arm patch. Returns synthetic-trained twist-collapse severity by original vertex section and current source. Diagnostic only: no repair or execution authority. Supply mesh, a 2..4 bone chain and existing ordered sections.", "annotations": {"readOnly