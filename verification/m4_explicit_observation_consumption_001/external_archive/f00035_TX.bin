ng_count':sum(row[2]=='remaining' for row in rows),'remaining_occlusion_witnesses':{c['name']:geom_facts[(93,c['name'])]['occluder_triangle'] for c in cameras['views']},'raster_limit':'six_actual_raster_attempt_limit; batch stopped before RIGHT; existing active BACK image and SCENE/LEFT buffers suffice for all eligible surfaces'},separators=(',',':')))"}}}
