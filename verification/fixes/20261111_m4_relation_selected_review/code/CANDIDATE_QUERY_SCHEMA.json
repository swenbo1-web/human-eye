{
  "type": "object",
  "description": "Selectors use name OR id. Legacy exact_pairs/nearest/top1 use object_ids/max_exact_pairs. nearest needs complete exact nonpenetrating order; top1 may prune by strict outward bounds and reports ties. Unknown/budget-limited proofs do not certify nearest.",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "task",
        "surface_nearest",
        "overview",
        "exact_pairs",
        "nearest",
        "top1",
        "mesh_structure",
        "mesh_surface"
      ]
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "oneOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "name"
            ]
          }
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4,
      "description": "Legacy task: aabb 1..4 selectors; pair facts two ordered A to B."
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "oneOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ],
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "oneOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "name"
            ]
          }
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 3,
      "description": "1..3 explicit candidates in request order; one capture with target. Requires closed_solid_relation and surface_proximity; aabb optional."
    },
    "requested_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aabb",
          "center_delta",
          "axis_gap",
          "surface_clearance",
          "solid_relation",
          "nearest_witness",
          "pair_relation",
          "surface_proximity",
          "closed_solid_relation"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "task: closed_solid_relation is zero-tolerance separated/touching/penetrating (positive-volume overlap, including containment) for represented connected closed triangle shells; invalid/ambiguous is unknown. surface_proximity independently gives nonnegative triangle-surface distance, original world witness points and positive-distance A-to-B direction; zero-distance direction is inapplicable. Boundary/nonmanifold counts do not certify solids. Penetrating/contained distances are not separated gaps. pair_relation's escape of A is not surface distance, nearest direction or minimum depth."
    },
    "geometry": {
      "type": "object",
      "description": "Opt-in geometry from the original relation bindings. Vertices use world metres; captured triangles are optional.",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "oneOf": [
              {
                "required": [
                  "id"
                ]
              },
              {
                "required": [
                  "name"
                ]
              }
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4
        },
        "include_triangles": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "objects"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "enum": [
        "diagnose",
        "patch",
        "reference",
        "restore_preview",
        "reference_patch"
      ],
      "description": "Registered target reads. mesh_structure: diagnose text or patch images. mesh_surface (local opt-in): diagnose/reference/restore_preview require include_image=false; reference_patch uses a returned opaque patch_ref and optional native images. References are locally trusted; previews do not execute; the original task budget applies."
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "near_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.001
    },
    "threshold_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.01
    },
    "reference_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4095
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "patch_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "description": "Trusted begin handoff, required in local lifecycle mode; selects the active generation without creating or renewing a task."
    },
    "object_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 255,
      "uniqueItems": true
    },
    "label_object_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "description": "Current full IDs for image annotation, separate from measurement object_ids: up to six related labels plus A/B. Missing pair/image, occlusion or undersampling is explicit; display only."
    },
    "max_exact_pairs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "alignment_evidence": {
      "type": "boolean",
      "default": true,
      "description": "False omits optional face angles and requires include_image=false; strict distance, host rigid-frame and action checks remain."
    },
    "support_plane_discovery": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read-only discovery of bounded original support-plane selectors for the current focal/reference pair. Omit direction for geometry only; no action direction is invented.",
      "properties": {
        "direction_world": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 4
        }
      }
    },
    "native_visual": {
      "type": "object",
      "description": "Display policy only; never execution permission. Auto uses a negotiated read-only native host, otherwise the analytical projection. Projection skips negotiation; multiscale requires support. Labels and contact sections require projection.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "projection",
            "multiscale"
          ]
        },
        "view": {
          "type": "string",
          "enum": [
            "SCENE",
            "XY",
            "XZ"
          ]
        }
      },
      "additionalProperties": false
    },
    "visual_diagnostic": {
      "type": "string",
      "enum": [
        "contact_section"
      ],
      "description": "Analytical full-mesh contact section beside natural views; not visibility evidence or action permission."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "surface_nearest"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "mode": {},
          "objects": {
            "maxItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "mode": {
                "const": "task"
              }
            },
            "required": [
              "mode"
            ]
          },
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "candidates"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "mode",
          "requested_facts"
        ],
        "properties": {
          "mode": {
            "const": "task"
          }
        },
        "oneOf": [
          {
            "required": [
              "objects"
            ],
            "properties": {
              "target": false,
              "candidates": false
            }
          },
          {
            "required": [
              "target",
              "candidates"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {},
              "target": {},
              "candidates": {},
              "geometry": {},
              "requested_facts": {
                "items": {
                  "enum": [
                    "closed_solid_relation",
                    "surface_proximity",
                    "aabb"
                  ]
                },
                "allOf": [
                  {
                    "contains": {
                      "const": "closed_solid_relation"
                    }
                  },
                  {
                    "contains": {
                      "const": "surface_proximity"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}