usage: perf000_scene_tool.py observe [-h] --workspace WORKSPACE [--image]
                                     [--focal FOCAL] [--reference REFERENCE]
                                     [--query-literal QUERY_LITERAL]
                                     [--instruction INSTRUCTION]
                                     [--detail {full,brief}]

options:
  -h, --help            show this help message and exit
  --workspace WORKSPACE
  --image
  --focal FOCAL
  --reference REFERENCE
  --query-literal QUERY_LITERAL
                        Python dict literal. For mode='task', include only
                        mode, objects and requested_facts. The text CLI
                        automatically sets include_image=false outside query;
                        do not put it inside task query. Legacy query modes
                        remain supported.
  --instruction INSTRUCTION
  --detail {full,brief}
