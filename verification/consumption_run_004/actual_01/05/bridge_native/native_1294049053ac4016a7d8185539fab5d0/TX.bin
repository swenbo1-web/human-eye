{"type":"execute_code","params":{"code":"import bpy,json\nrows=[]\nfor obj in bpy.context.scene.objects:\n    if obj.type!='MESH': continue\n    mesh=obj.data\n    rows.append({'name':obj.name,'matrix_world':[list(r) for r in obj.matrix_world],'world_vertices':[list(obj.matrix_world @ v.co) for v in mesh.vertices],'polygons':[list(p.vertices) for p in mesh.polygons]})\nprint(json.dumps(rows,ensure_ascii=False))"}}
