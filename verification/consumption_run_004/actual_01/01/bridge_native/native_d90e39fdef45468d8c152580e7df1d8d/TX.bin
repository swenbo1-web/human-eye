{"type":"execute_code","params":{"code":"import bpy,json\ns=bpy.context.scene\ndg=bpy.context.evaluated_depsgraph_get()\nrows=[]\nfor o in s.objects:\n if o.type=='MESH':\n  e=o.evaluated_get(dg)\n  v=[tuple(float(c) for c in e.matrix_world@p.co) for p in e.data.vertices]\n  faces=[tuple(p.vertices) for p in e.data.polygons]\n  rows.append({'name':o.name,'evaluated_vertices_world':v,'evaluated_faces':faces,'shape_keys':o.data.shape_keys.name if o.data.shape_keys else None,'mode':o.mode})\nprint(json.dumps({'mesh_count':len(rows),'scale_length':s.unit_settings.scale_length,'meshes':rows},ensure_ascii=False))"}}
