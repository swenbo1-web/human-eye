{"type":"execute_code","params":{"code":"import bpy,json\ns=bpy.context.scene\nout=[]\nfor o in s.objects:\n if o.type=='MESH':\n  out.append({'name':o.name,'matrix_world':[list(r) for r in o.matrix_world],'vertices_world':[list(o.matrix_world@v.co) for v in o.data.vertices],'polygons':[list(p.vertices) for p in o.data.polygons],'edges':[list(e.vertices) for e in o.data.edges]})\nprint(json.dumps({'scale_length':s.unit_settings.scale_length,'meshes':out},ensure_ascii=False))"}}
