{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\nprint(json.dumps({'scene':s.name,'units':{'system':s.unit_settings.system,'scale_length':s.unit_settings.scale_length},'objects':[{'name':o.name,'type':o.type,'vertices':len(o.data.vertices) if o.type=='MESH' else None,'polygons':len(o.data.polygons) if o.type=='MESH' else None,'modifiers':[{'type':m.type,'show_viewport':m.show_viewport} for m in o.modifiers]} for o in s.objects]},ensure_ascii=False))"}}
