{"type":"execute_code","params":{"code":"import bpy, json\nscene = bpy.context.scene\ndepsgraph = bpy.context.evaluated_depsgraph_get()\nreadout = {'scene_name': scene.name, 'unit_system':scene.unit_settings.system, 'scale_length':scene.unit_settings.scale_length, 'meshes':[]}\nfor obj in scene.objects:\n    if obj.type != 'MESH':\n        continue\n    eobj = obj.evaluated_get(depsgraph)\n    mesh = eobj.to_mesh()\n    try:\n        mesh.calc_loop_triangles()\n        readout['meshes'].append({'name':obj.name, 'vertices_world':[list(eobj.matrix_world @ v.co) for v in mesh.vertices], 'triangles':[list(t.vertices) for t in mesh.loop_triangles], 'raw_vertices':len(obj.data.vertices), 'raw_polygons':len(obj.data.polygons), 'modifiers':[m.type for m in obj.modifiers]})\n    finally:\n        eobj.to_mesh_clear()\nprint(json.dumps(readout,ensure_ascii=False))"}}
