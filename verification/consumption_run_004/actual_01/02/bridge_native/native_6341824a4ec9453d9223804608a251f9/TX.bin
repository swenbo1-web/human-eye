{"type":"execute_code","params":{"code":"import bpy, json\nscene=bpy.context.scene\nout={'scene':scene.name,'unit_system':scene.unit_settings.system,'scale_length':scene.unit_settings.scale_length,'objects':[]}\nfor obj in scene.objects:\n    if obj.type != 'MESH':\n        continue\n    mesh=obj.data\n    mesh.calc_loop_triangles()\n    out['objects'].append({'name':obj.name,'vertices_world':[list(obj.matrix_world @ v.co) for v in mesh.vertices], 'triangles':[list(t.vertices) for t in mesh.loop_triangles], 'modifiers':[{'name':m.name,'type':m.type,'show_viewport':m.show_viewport} for m in obj.modifiers], 'hide_viewport':obj.hide_viewport})\nprint(json.dumps(out,ensure_ascii=False))"}}
