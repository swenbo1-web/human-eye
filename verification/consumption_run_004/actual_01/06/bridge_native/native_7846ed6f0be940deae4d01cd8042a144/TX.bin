{"type":"execute_code","params":{"code":"import bpy, json\ns=bpy.context.scene\nout={'unit_system':s.unit_settings.system,'scale_length':s.unit_settings.scale_length,'objects':[]}\nfor o in s.objects:\n    if o.type=='MESH':\n        m=o.data\n        out['objects'].append({'name':o.name,'matrix_world':[list(row) for row in o.matrix_world],'vertices':[list(o.matrix_world @ v.co) for v in m.vertices],'polygons':[list(p.vertices) for p in m.polygons],'modifiers':[{'name':q.name,'type':q.type,'show_viewport':q.show_viewport} for q in o.modifiers]})\nprint(json.dumps(out,ensure_ascii=False))"}}
