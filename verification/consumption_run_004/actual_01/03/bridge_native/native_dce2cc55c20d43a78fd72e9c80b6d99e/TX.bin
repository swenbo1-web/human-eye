{"type":"execute_code","params":{"code":"import bpy, json, math\nfrom mathutils import Vector\nscene = bpy.context.scene\ndg = bpy.context.evaluated_depsgraph_get()\nsummary = []\nfor obj in sorted(scene.objects, key=lambda o: o.name):\n    if obj.type != 'MESH':\n        continue\n    ev = obj.evaluated_get(dg)\n    mesh = ev.to_mesh()\n    try:\n        mesh.calc_loop_triangles()\n        vv = [tuple(ev.matrix_world @ v.co) for v in mesh.vertices]\n        tt = [tuple(t.vertices) for t in mesh.loop_triangles]\n        deg = []\n        for i,t in enumerate(tt):\n            a,b,c = (Vector(vv[j]) for j in t)\n            if (b-a).cross(c-a).length_squared == 0:\n                deg.append({'triangle_index': i, 'vertices': [vv[j] for j in t]})\n        summary.append({'name':obj.name,'vertex_count':len(vv),'triangle_count':len(tt),'polygon_sizes':sorted(set(len(p.vertices) for p in mesh.polygons)), 'aabb_min':[min(v[k] for v in vv) for k in range(3)] if vv else None,'aabb_max':[max(v[k] for v in vv) for k in range(3)] if vv else None, 'degenerate_triangles':deg,'small_geometry':{'vertices':vv,'triangles':tt} if len(tt)<5 else None,'modifiers':len(obj.modifiers)})\n    finally:\n        ev.to_mesh_clear()\nprint(json.dumps({'unit_system':scene.unit_settings.system,'scale_length':scene.unit_settings.scale_length,'meshes':summary,'instance_count':sum(1 for x in dg.object_instances if x.is_instance)},ensure_ascii=False))"}}
