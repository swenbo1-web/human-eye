{"type":"execute_code","params":{"code":"import bpy, json\nfrom mathutils import Vector\nscene = bpy.context.scene\ndg = bpy.context.evaluated_depsgraph_get()\nrecords = []\nfor obj in sorted(scene.objects, key=lambda o: o.name):\n    if obj.type != 'MESH':\n        continue\n    ev = obj.evaluated_get(dg)\n    mesh = ev.to_mesh()\n    try:\n        mesh.calc_loop_triangles()\n        records.append({'name': obj.name, 'vertices_world': [list(ev.matrix_world @ v.co) for v in mesh.vertices], 'triangles': [list(t.vertices) for t in mesh.loop_triangles], 'polygons': [list(p.vertices) for p in mesh.polygons], 'modifiers': [{'name': m.name, 'type': m.type} for m in obj.modifiers]})\n    finally:\n        ev.to_mesh_clear()\nprint(json.dumps({'scene': scene.name, 'unit_system': scene.unit_settings.system, 'scale_length': scene.unit_settings.scale_length, 'meshes': records, 'instance_count': sum(1 for x in dg.object_instances if x.is_instance)}, ensure_ascii=False))"}}
