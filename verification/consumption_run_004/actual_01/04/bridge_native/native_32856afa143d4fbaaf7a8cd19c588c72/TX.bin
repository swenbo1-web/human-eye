{"type":"execute_code","params":{"code":"import bpy, json\nscene=bpy.context.scene\nprint(json.dumps({'scene':scene.name,'unit_system':scene.unit_settings.system,'scale_length':scene.unit_settings.scale_length,'objects':[{'name':o.name,'type':o.type,'data':getattr(o.data,'name',None),'vertices':len(o.data.vertices) if o.type=='MESH' else None,'polygons':len(o.data.polygons) if o.type=='MESH' else None,'hide_viewport':o.hide_viewport,'hide_render':o.hide_render,'modifiers':[{'name':m.name,'type':m.type,'show_viewport':m.show_viewport} for m in o.modifiers] if o.type=='MESH' else [],'matrix_world':[list(row) for row in o.matrix_world]} for o in scene.objects]},ensure_ascii=False))"}}
