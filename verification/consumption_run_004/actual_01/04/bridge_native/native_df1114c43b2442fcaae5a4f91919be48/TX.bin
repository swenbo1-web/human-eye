{"type":"execute_code","params":{"code":"import bpy, json, math\nscene=bpy.context.scene\nreadout=[]\nfor o in scene.objects:\n    if o.type!='MESH': continue\n    m=o.data\n    vs=[tuple(sum(float(o.matrix_world[i][j])*float(v.co[j]) for j in range(3))+float(o.matrix_world[i][3]) for i in range(3)) for v in m.vertices]\n    tris=[tuple(p.vertices) for p in m.polygons if len(p.vertices)==3]\n    deg=[]\n    for ti,t in enumerate(tris):\n        a,b,c=[vs[i] for i in t]\n        u=[b[i]-a[i] for i in range(3)]; v=[c[i]-a[i] for i in range(3)]\n        n=(u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0])\n        if all(x==0 for x in n): deg.append(ti)\n    d={'name':o.name,'vertices':len(vs),'polygons':len(m.polygons),'triangle_count':len(tris),'nontriangles':[p.index for p in m.polygons if len(p.vertices)!=3],'bounds':[[min(v[i] for v in vs),max(v[i] for v in vs)] for i in range(3)],'degenerate_triangles':deg,'nonfinite':any(not math.isfinite(x) for v in vs for x in v)}\n    if len(vs)<=3: d['world_vertices']=vs; d['triangles']=tris\n    readout.append(d)\nprint(json.dumps(readout,ensure_ascii=False))"}}
