{"type":"execute_code","params":{"code":"import bpy, json\nprint(json.dumps({'meshes':[{'name':o.name,'vertices_local':[[float(c) for c in v.co] for v in o.data.vertices],'vertices_world':[[float(c) for c in (o.matrix_world @ v.co)] for v in o.data.vertices],'faces':[list(p.vertices) for p in o.data.polygons],'edges':[list(e.vertices) for e in o.data.edges],'hide_viewport':o.hide_viewport,'hide_get':o.hide_get()} for o in bpy.context.scene.objects if o.type=='MESH']},ensure_ascii=False))"}}
