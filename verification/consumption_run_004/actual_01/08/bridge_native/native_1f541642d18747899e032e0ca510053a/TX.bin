{"type":"execute_code","params":{"code":"import bpy, math, json\nfrom mathutils import Vector\nprint(json.dumps({'scene':bpy.context.scene.name,'unit_system':bpy.context.scene.unit_settings.system,'scale_length':bpy.context.scene.unit_settings.scale_length,'objects':[{'name':o.name,'type':o.type,'verts':len(o.data.vertices) if o.type=='MESH' else None,'polygons':len(o.data.polygons) if o.type=='MESH' else None,'modifiers':[{'name':m.name,'type':m.type,'show_viewport':m.show_viewport} for m in o.modifiers],'matrix_world':[list(row) for row in o.matrix_world]} for o in bpy.context.scene.objects]},ensure_ascii=False))"}}
