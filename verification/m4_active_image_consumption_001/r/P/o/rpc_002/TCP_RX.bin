{"request_id":"5ced0e2f4c994d87b5674ee6219b05c8","ok":true,"result":{"jsonrpc":"2.0","id":1,"result":{"tools":[{"name":"execute_python","description":"Execute ordinary Python in a persistent namespace and return stdout and stderr text. The image_files mapping provides the two supplied image paths under opaque references view-a and view-b. Standard Python reading and your own computations are available. Restrict reads to these supplied images and your own computations. Keep files unchanged. Use read_image to receive an image content block.","inputSchema":{"type":"object","properties":{"code":{"type":"string"}},"required":["code"],"additionalProperties":false}},{"name":"read_image","description":"Read an existing supplied PNG and return its actual image content. References view-a and view-b are available, each 512x512 image/png. When obtaining both images, request view-a followed by view-b.","inputSchema":{"type":"object","properties":{"ref":{"type":"string","enum":["view-a","view-b"]}},"required":["ref"],"additionalProperties":false}},{"name":"human_eye_image_observe","description":"Experimental read-only active-observation image outlet. Return the actual existing supplied PNG images for the requested opaque references, in view-a then view-b order. Each image is 512x512 image/png. This outlet replays registered images.","inputSchema":{"type":"object","properties":{"refs":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"string","enum":["view-a","view-b"]}}},"required":["refs"],"additionalProperties":false}}]}}}
